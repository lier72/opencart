<?xml version="1.0" encoding="utf-8"?>
<modification>
    <name>Create Odoo Order Buttons</name>
    <version>1.0</version>
    <author>Max Surdu</author>
    <link>http://uniqsport.ru</link>
    <code>odoo_integration_order_list</code>
    <description>Adds Odoo Integration "Create Order" button to order list (OpenCart 3.0 compatible)</description>

    <!-- Add button to order list template (Twig) -->
    <file path="admin/view/template/sale/order_list.twig">
        <operation>
            <search><![CDATA[<div class="btn-group"> <a href="{{ order.view }}" data-toggle="tooltip" title="{{ button_view }}" class="btn btn-primary"><i class="fa fa-eye"></i></a>]]></search>
            <add position="before"><![CDATA[<button type="button" onclick="createOdooOrder('{{ order.order_id }}');" data-toggle="tooltip" title="{{ button_create_odoo }}" class="btn btn-success"><i class="fa fa-cloud-upload"></i></button> ]]></add>
        </operation>
        <operation>
            <search><![CDATA[{{ footer }}]]></search>
            <add position="before"><![CDATA[<script type="text/javascript"><!--
function createOdooOrder(order_id) {
    console.log('Creating Odoo order for Order ID: ' + order_id);

    if (!confirm('{{ text_confirm_odoo }}')) {
        return;
    }

    var $button = $('button[onclick="createOdooOrder(\'' + order_id + '\')"]');
    var originalHtml = $button.html();

    $.ajax({
        url: 'index.php?route=extension/module/odoo_connector/createOdooOrder&user_token={{ user_token }}&order_id=' + order_id,
        type: 'POST',
        dataType: 'json',
        beforeSend: function() {
            $button.prop('disabled', true);
            $button.html('<i class="fa fa-spinner fa-spin"></i>');
        },
        complete: function() {
            $button.prop('disabled', false);
            $button.html(originalHtml);
        },
        success: function(json) {
            $('.alert-dismissible').remove();

            if (json['error']) {
                $('#content > .container-fluid').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
            }

            if (json['success']) {
                $('#content > .container-fluid').prepend('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');

                // Optionally reload the page to refresh order status
                // location.reload();
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            alert('Error: ' + thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
}
//--></script>
]]></add>
        </operation>
    </file>

    <!-- Add button text to controller -->
    <file path="admin/controller/sale/order.php">
        <operation>
            <search><![CDATA[$data['user_token'] = $this->session->data['user_token'];]]></search>
            <add position="after"><![CDATA[

		// Odoo Integration button
		$data['button_create_odoo'] = $this->language->get('button_create_odoo');
		$data['text_confirm_odoo'] = $this->language->get('text_confirm_odoo');]]></add>
        </operation>
    </file>

    <!-- Add language strings (English) -->
    <file path="admin/language/en-gb/sale/order.php">
        <operation>
            <search><![CDATA[$_['button_edit']]]></search>
            <add position="after"><![CDATA[
$_['button_create_odoo']         = 'Create in Odoo';]]></add>
        </operation>
        <operation>
            <search><![CDATA[$_['text_confirm']]]></search>
            <add position="after"><![CDATA[
$_['text_confirm_odoo']          = 'Are you sure you want to create this order in Odoo?';]]></add>
        </operation>
    </file>

    <!-- Add language strings (Russian) -->
    <file path="admin/language/ru-ru/sale/order.php">
        <operation>
            <search><![CDATA[$_['button_edit']]]></search>
            <add position="after"><![CDATA[
$_['button_create_odoo']         = 'Создать в Odoo';]]></add>
        </operation>
        <operation>
            <search><![CDATA[$_['text_confirm']]]></search>
            <add position="after"><![CDATA[
$_['text_confirm_odoo']          = 'Вы уверены, что хотите создать этот заказ в Odoo?';]]></add>
        </operation>
    </file>
</modification>