{{ header }}
{% if journal3.get('pageTitlePosition') == 'top' %}
  <h1 class="title page-title {{ journal3.get('title_color_scheme') }}"><span class="page-title-text">{{ heading_title }}</span></h1>
{% endif %}
<div class="breadcrumbs {{ journal3.get('breadcrumbs_color_scheme') }}">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
</div>
{{ journal3_top }}
<div id="account-login" class="container">
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}</div>
  {% endif %}
  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">
      {% if journal3.get('pageTitlePosition') == 'default' %}
      <h1 class="title page-title {{ journal3.get('title_color_scheme') }}">{{ heading_title }}</h1>
      {% endif %}
      {{ content_top }}
      <div class="row login-box">
        {% if not journal3.is_popup %}
        <div class="col-sm-6">
          <div class="well">
            <h2 class="title">{{ text_new_customer }}</h2>
            <p><strong>{{ text_register }}</strong></p>
            <p>{{ text_register_account }}</p>
            <div class="buttons">
              <div class="pull-right">
                <a href="{{ register }}" class="btn btn-primary">{{ button_continue }}</a>
              </div>
            </div>
          </div>
        </div>
        {% endif %}
        <div class="col-sm-6">
          <div class="well">
            <h2 class="title">{{ text_returning_customer }}</h2>
            <p><strong>{{ text_i_am_returning_customer }}</strong></p>
            <div id="alert" class="toast-container position-fixed top-0 end-0 p-3"></div>
            <form action="{{ journal3_is_oc4 ? login : action }}" method="post" {% if journal3_is_oc3 %}enctype="multipart/form-data"{% endif%} class="login-form form-horizontal" {% if journal3_is_oc4 %}data-oc-toggle="ajax"{% endif %}>
              <div class="form-group">
                <label class="control-label" for="input-email">{{ entry_email }}</label>
                <input type="text" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" />
              </div>
              <div class="form-group">
                <label class="control-label" for="input-password">{{ entry_password }}</label>
                <input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password }}" id="input-password" class="form-control" />
                </div><a class="forgot-password" href="{{ forgotten }}" target="_top">{{ text_forgotten }}</a>
              <div class="buttons">
                <div class="pull-right">
                  <button type="submit" class="btn btn-primary" data-loading-text="<span>{{ button_login }}</span>"><span>{{ button_login }}</span></button>
                </div>
              </div>
{#                {% if journal3.is_popup %}
                <p>{{ oasl_widget }}</p>
              {% endif %}  #}
              {% if redirect %}
              <input type="hidden" name="redirect" value="{{ redirect }}" />
              {% endif %}
            </form>
          </div>
        </div>
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
      {# If this template is rendered inside Journal3 popup and login succeeded or a redirect is present,
         close parent modal and redirect the top window so account page isn't shown inside the modal. #}
      {% if journal3.is_popup and (redirect or success) %}
      <script>
      (function(){
        // Gather redirect URL if provided by the server
        var redirectUrl = {% if redirect %}'{{ redirect|e('js') }}'{% else %}null{% endif %};

        var message = { type: 'journal3:close_and_redirect', redirect: redirectUrl };

        // Send a postMessage to parent/top — safe for cross-origin. Parent footer will listen and act.
        try { window.parent.postMessage(message, '*'); } catch (e) {}
        try { top.postMessage(message, '*'); } catch (e) {}

        // If same-origin, also try to directly close modals and redirect for immediate effect.
        var sameOrigin = false;
        try {
          // Accessing parent.document will throw if cross-origin
          void window.parent.document;
          sameOrigin = true;
        } catch (e) {
          sameOrigin = false;
        }

        if (sameOrigin) {
          try {
            if (window.parent.jQuery) {
              window.parent.jQuery('.modal').modal('hide');
            }
          } catch (e) {}

          try {
            if (window.parent.journal3) {
              if (window.parent.journal3.modal && typeof window.parent.journal3.modal.hide === 'function') {
                window.parent.journal3.modal.hide();
              } else if (window.parent.journal3.modal && typeof window.parent.journal3.modal === 'function') {
                try { window.parent.journal3.modal('hide'); } catch(e){}
              } else if (window.parent.journal3.popup && typeof window.parent.journal3.popup.close === 'function') {
                window.parent.journal3.popup.close();
              }
            }
          } catch (e) {}

          try {
            if (redirectUrl) {
              try { top.location.href = redirectUrl; } catch (e) { window.location = redirectUrl; }
            } else {
              try { if (top && top.location) top.location.reload(true); } catch(e) { window.location.reload(true); }
            }
          } catch (e) {}
        }
      })();
      </script>
      {% endif %}

      {# Register OneAll callback so social login can notify parent to close modal and redirect.
      {% if journal3.is_popup %}
      <script>
      (function(){
        try {
          var _oneall = window._oneall || (window._oneall = []);

          _oneall.push(['social_login', 'set_event', 'on_login_redirect', function(args) {
            // args may contain redirect info depending on OneAll setup
            var redirectUrl = (args && args.redirect) ? args.redirect : null;

            // Send safe message to parent/top (works cross-origin)
            var message = { type: 'journal3:close_and_redirect', redirect: redirectUrl };
            try { window.parent.postMessage(message, '*'); } catch (e) {}
            try { top.postMessage(message, '*'); } catch (e) {}

            // If same-origin, also attempt direct modal hide + redirect for immediate UX
            try {
              void window.parent.document; // will throw if cross-origin
              try { if (window.parent.jQuery) window.parent.jQuery('.modal.show').modal('hide'); } catch(e) {}
              try {
                if (redirectUrl) { try { top.location.href = redirectUrl; } catch(e) { window.location = redirectUrl; } }
                else { try { top.location.reload(true); } catch(e) { window.location.reload(true); } }
              } catch(e) {}
            } catch (e) {
              // cross-origin — parent will handle via postMessage
            }
          }]);
        } catch (e) {
          // ignore errors
        }
      })();
      </script>
      {% endif %} #}

      {{ footer }}
