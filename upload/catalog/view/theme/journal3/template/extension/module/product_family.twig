{% macro variant_value(variant, value_class) %}
  {% if variant.color_hex %}
    <span class="{{ value_class }} variant-color-value">
      <span class="variant-color-swatch{% if variant.color_is_light %} is-light{% endif %}" style="--product-family-swatch-color: {{ variant.color_hex }};" title="{{ variant.raw_value ?: variant.color_hex }}"></span>
      {% if variant.value %}
        <span class="variant-color-label">{{ variant.value }}</span>
      {% endif %}
    </span>
  {% else %}
    <span class="{{ value_class }}">{{ variant.value }}</span>
  {% endif %}
{% endmacro %}

{% macro variant_item(product, show_image, show_price, text_out_of_stock, text_sku) %}
  <div class="variant-item{% if not product.in_stock %} variant-out-of-stock{% endif %}">
    {% if product.in_stock %}
      <a href="{{ product.href }}" class="variant-link">
    {% else %}
      <span class="variant-link is-disabled" aria-disabled="true">
    {% endif %}
      {% if show_image and product.image %}
        <span class="variant-image">
          <img src="{{ product.image }}" alt="{{ product.name }}" class="img-responsive" />
        </span>
      {% endif %}

      <span class="variant-details">
        {% if product.variants %}
          <span class="variant-attributes">
            {% for variant in product.variants %}
              <span class="variant-attribute">
                <span class="variant-attribute-name">{{ variant.name }}:</span>
                {{ _self.variant_value(variant, 'variant-attribute-value') }}
              </span>
            {% endfor %}
          </span>
        {% endif %}

        <span class="variant-meta">
          <span class="variant-model">{{ text_sku }}: {{ product.model }}</span>

          {% if show_price %}
            <span class="variant-price">
              {% if product.special %}
                <span class="price-old">{{ product.price }}</span>
                <span class="price-new">{{ product.special }}</span>
              {% else %}
                <span class="price">{{ product.price }}</span>
              {% endif %}
            </span>
          {% endif %}
        </span>

        {% if not product.in_stock %}
          <span class="variant-stock-status">{{ text_out_of_stock }}</span>
        {% endif %}
      </span>
    {% if product.in_stock %}
      </a>
    {% else %}
      </span>
    {% endif %}
  </div>
{% endmacro %}

{% import _self as family %}

{% if products|length > 0 %}
  <link rel="stylesheet" href="catalog/view/theme/journal3/stylesheet/product_family.css" />

  {% set sorted_products = [] %}
  {% for product in products %}
    {% if product.in_stock %}
      {% set sorted_products = sorted_products|merge([product]) %}
    {% endif %}
  {% endfor %}
  {% for product in products %}
    {% if not product.in_stock %}
      {% set sorted_products = sorted_products|merge([product]) %}
    {% endif %}
  {% endfor %}

  {% set visible_products = sorted_products|slice(0, 3) %}
  {% set hidden_products = sorted_products|slice(3) %}
  {% set hidden_count = hidden_products|length %}

  <div class="product-family-wrapper{% if show_image %} has-images{% endif %}">
    <div class="product-family-section">
      <h3 class="product-family-title">{{ heading_title }}</h3>

      <div class="product-family-content">
        {% if current_variants %}
          <div class="product-family-current">
            <span class="product-family-current-label">{{ text_current_variant }}:</span>

            <div class="product-family-current-values">
              {% for variant in current_variants %}
                <span class="product-family-current-chip">
                  {{ variant.name }}:
                  {{ family.variant_value(variant, 'current-variant-value') }}
                </span>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <div class="product-family-variants">
          {% for product in visible_products %}
            {{ family.variant_item(product, show_image, show_price, text_out_of_stock, text_sku) }}
          {% endfor %}
        </div>

        {% if hidden_count %}
          <div class="product-family-more">
            <div class="product-family-variants product-family-variants-extra">
              {% for product in hidden_products %}
                {{ family.variant_item(product, show_image, show_price, text_out_of_stock, text_sku) }}
              {% endfor %}
            </div>

            <button type="button" class="btn btn-default btn-product-family-toggle" aria-expanded="false">
              <span class="product-family-toggle-text product-family-toggle-text-more">{{ text_show_more|format(hidden_count) }}</span>
              <span class="product-family-toggle-text product-family-toggle-text-less">{{ text_show_less }}</span>
              <i class="fa fa-chevron-down" aria-hidden="true"></i>
            </button>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {% if hidden_count %}
    <script>
    (function() {
      var wrappers = document.querySelectorAll('.product-family-more');

      wrappers.forEach(function(wrapper) {
        var button = wrapper.querySelector('.btn-product-family-toggle');

        if (!button || button.dataset.bound === '1') {
          return;
        }

        button.dataset.bound = '1';

        button.addEventListener('click', function() {
          var isOpen = wrapper.classList.toggle('is-open');

          button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
      });
    })();
    </script>
  {% endif %}
{% endif %}
