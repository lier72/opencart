{# Journal3 Size Selector Module Template #}

<div id="size-selector-container" class="size-selector-widget" data-product-id="{{ product_id }}">
	<div class="size-selector-loading">
		<i class="fa fa-spinner fa-spin"></i> Загрузка размеров...
	</div>
</div>

{# Include JavaScript #}
<script src="catalog/view/theme/journal3/js/size_selector.js"></script>

{# Include CSS #}
<style>
/* Size Selector Styles */
.size-selector-widget {
	margin: 20px 0;
	padding: 15px;
	border: 1px solid #e5e5e5;
	border-radius: 4px;
	background: #fff;
}

.size-selector-loading {
	text-align: center;
	padding: 20px;
	color: #999;
}

/* Gender Selector */
.size-gender-selector {
	display: flex;
	gap: 10px;
	margin-bottom: 15px;
	padding-bottom: 15px;
	border-bottom: 1px solid #e5e5e5;
}

.btn-gender {
	flex: 1;
	padding: 10px 15px;
	border: 2px solid #ddd;
	background: #f9f9f9;
	border-radius: 4px;
	cursor: pointer;
	transition: all 0.3s ease;
	font-size: 14px;
	font-weight: 500;
}

.btn-gender:hover {
	border-color: #999;
	background: #fff;
}

.btn-gender.active {
	border-color: {{ journal3.get('colorPrimary') || '#000' }};
	background: {{ journal3.get('colorPrimary') || '#000' }};
	color: #fff;
}

/* System Selector */
.size-system-selector {
	display: flex;
	gap: 8px;
	margin-bottom: 15px;
	flex-wrap: wrap;
}

.btn-system {
	padding: 8px 16px;
	border: 1px solid #ddd;
	background: #fff;
	border-radius: 20px;
	cursor: pointer;
	transition: all 0.3s ease;
	font-size: 13px;
	font-weight: 500;
}

.btn-system:hover {
	border-color: #999;
	background: #f5f5f5;
}

.btn-system.active {
	border-color: {{ journal3.get('colorPrimary') || '#000' }};
	background: {{ journal3.get('colorPrimary') || '#000' }};
	color: #fff;
}

/* Size Grid */
.size-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
	gap: 10px;
	margin-bottom: 15px;
}

.btn-size {
	position: relative;
	padding: 12px 8px;
	border: 2px solid #ddd;
	background: #fff;
	border-radius: 4px;
	cursor: pointer;
	transition: all 0.3s ease;
	text-align: center;
	min-height: 60px;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.btn-size:hover:not(.out-of-stock):not([disabled]) {
	border-color: #999;
	transform: translateY(-2px);
	box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.btn-size.selected {
	border-color: {{ journal3.get('colorPrimary') || '#000' }};
	background: {{ journal3.get('colorPrimary') || '#000' }};
	color: #fff;
}

.btn-size .size-label {
	font-size: 15px;
	font-weight: 600;
	display: block;
	margin-bottom: 4px;
}

.btn-size .stock-indicator {
	font-size: 11px;
	display: block;
	color: #666;
}

.btn-size.selected .stock-indicator {
	color: rgba(255,255,255,0.8);
}

.btn-size.low-stock {
	border-color: #ffa500;
}

.btn-size.low-stock .stock-indicator {
	color: #ff8c00;
}

.btn-size.out-of-stock {
	opacity: 0.4;
	cursor: not-allowed;
	background: #f5f5f5;
}

.btn-size.out-of-stock .stock-indicator {
	color: #d9534f;
}

/* Size Guide Link */
.size-guide-link {
	text-align: center;
	padding-top: 10px;
	border-top: 1px solid #e5e5e5;
}

.btn-size-guide {
	color: {{ journal3.get('colorPrimary') || '#000' }};
	text-decoration: none;
	font-size: 13px;
	font-weight: 500;
	display: inline-flex;
	align-items: center;
	gap: 6px;
}

.btn-size-guide:hover {
	text-decoration: underline;
}

.btn-size-guide i {
	font-size: 14px;
}

/* Size Guide Modal */
.size-guide-modal .modal-dialog {
	max-width: 800px;
}

.size-guide-modal .modal-body {
	padding: 20px;
}

.size-conversion-table,
.measurements-table {
	margin-bottom: 20px;
}

.size-conversion-table h5,
.measurements-table h5 {
	margin-bottom: 15px;
	font-size: 16px;
	font-weight: 600;
	color: #333;
}

.size-conversion-table table,
.measurements-table table {
	font-size: 13px;
}

.size-conversion-table th,
.measurements-table th {
	background: #f5f5f5;
	font-weight: 600;
	text-align: center;
}

.size-conversion-table td,
.measurements-table td {
	text-align: center;
	padding: 8px 5px;
}

/* Mobile Responsive */
@media (max-width: 576px) {
	.size-grid {
		grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));
		gap: 8px;
	}

	.btn-size {
		padding: 10px 5px;
		min-height: 55px;
	}

	.btn-size .size-label {
		font-size: 14px;
	}

	.btn-gender,
	.btn-system {
		font-size: 12px;
		padding: 8px 10px;
	}

	.size-conversion-table table,
	.measurements-table table {
		font-size: 11px;
	}

	.size-conversion-table td,
	.measurements-table td {
		padding: 6px 3px;
	}
}
</style>
