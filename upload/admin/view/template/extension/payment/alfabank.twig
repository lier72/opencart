{{ header }}{{ column_left }}

<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-alfabank" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="container-fluid">

        {% if (remoteVersion) %}
            <div class="alert alert-info"><i class="fa fa-exclamation-circle"></i>
                <strong>A new version is available:</strong> {{ remoteVersion }}<br>
                You are currently using version <strong>{{ currentVersion }}</strong>, but version <strong>{{ remoteVersion }}</strong> is available.<br>
                Please <a href="{{ newVersionUri }}">download the latest version here</a>
            </div>
        {% endif %}

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_settings }}</h3>
            </div>
            <div class="panel-body">

                <ul class="nav nav-tabs" id="alfabank-tabs">
                    <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
                    {% if enable_cart_options %}<li><a href="#tab-cart" data-toggle="tab">{{ tab_cart }}</a></li>{% endif %}
{#                    <li><a href="#tab-statuses" data-toggle="tab">tab_statuses </a></li>#}
                    <li><a href="#tab-miscellaneous" data-toggle="tab">{{ tab_miscellaneous }}</a></li>
                </ul>

                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-alfabank" class="form-horizontal">


                    <div class="tab-content">

                        <div class="tab-pane active" id="tab-general">
                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="payment_alfabank_status">
                                    {{ entry_status }}
                                </label>

                                <div class="col-sm-9">
                                    <select name="payment_alfabank_status" id="payment_alfabank_status" class="form-control">
                                        {% if payment_alfabank_status %}
                                            <option value="1" selected="selected">{{ status_enabled }}</option>
                                            <option value="0">{{ status_disabled }}</option>
                                        {% else %}
                                            <option value="1">{{ status_enabled }}</option>
                                            <option value="0" selected="selected">{{ status_disabled }}</option>
                                        {% endif %}
                                    </select>
                                </div>
                            </div>

                            {% if api_version == 2 %}
                                <!-- token -->
                                <div class="form-group">
                                    <label class="col-sm-3 control-label" for="">
                                        {{ entry_merchantToken }}
                                    </label>
                                    <div class="col-sm-9">
                                        <input type="password" name="payment_alfabank_merchantToken" value="{{ payment_alfabank_merchantToken }}" class="form-control" />
                                    </div>
                                </div>
                            {% else %}
                                <!-- login >> {{ api_version }} -->
                                <div class="form-group">
                                    <label class="col-sm-3 control-label" for="">
                                        {{ entry_merchantLogin }}
                                    </label>
                                    <div class="col-sm-9">
                                        <input type="text" name="payment_alfabank_merchantLogin" value="{{ payment_alfabank_merchantLogin }}" class="form-control" />
                                    </div>
                                </div>

                                <!-- pass -->
                                <div class="form-group">
                                    <label class="col-sm-3 control-label" for="">
                                        {{ entry_merchantPassword }}
                                    </label>
                                    <div class="col-sm-9">
                                        <input type="password" name="payment_alfabank_merchantPassword" value="{{ payment_alfabank_merchantPassword }}" class="form-control" />
                                    </div>
                                </div>
                            {% endif %}

                            <!-- mode -->
                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    {{ entry_mode }}
                                </label>
                                <div class="col-sm-9">
                                    <select name="payment_alfabank_mode" class="form-control">
                                        <option value="test" {{ payment_alfabank_mode  == 'test' ? 'selected="selected"' : '' }}>{{ mode_test }}</option>
                                        <option value="prod" {{ payment_alfabank_mode  == 'prod' ? 'selected="selected"' : '' }}>{{ mode_prod }}</option>
                                    </select>
                                </div>
                            </div>

                            {% if (enable_cacert) %}
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        {{ entry_enable_cacert }}
                                    </label>
                                    <div class="col-sm-9">
                                        <select name="payment_alfabank_enable_cacert" class="form-control">
                                            <option value="1" {{ payment_alfabank_enable_cacert  == 1 ? 'selected="selected"' : '' }}>{{ cacert_enabled }}</option>
                                            <option value="0" {{ payment_alfabank_enable_cacert  == 0 ? 'selected="selected"' : '' }}>{{ cacert_disabled }}</option>
                                        </select>
                                    </div>
                                </div>
                            {% endif %}

                            <!-- staging -->
                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    {{ entry_stage }}
                                </label>
                                <div class="col-sm-9">
                                    <select name="payment_alfabank_stage" class="form-control">
                                        <option value="one" {{ payment_alfabank_stage  == 'one' ? 'selected="selected"' : '' }}>{{ stage_one }}</option>
                                        <option value="two" {{ payment_alfabank_stage  == 'two' ? 'selected="selected"' : '' }}>{{ stage_two }}</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="input-order-status-before">{{ entry_order_status_before }}</label>
                                <div class="col-sm-9">
                                    <select name="payment_alfabank_order_status_before_id" id="input-order-status-before" class="form-control">
                                        {% for order_status in order_statuses %}
                                            {% if order_status.order_status_id == payment_alfabank_order_status_before_id %}
                                                <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                                            {% else %}
                                                <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="input-order-status-completed">{{ entry_order_status_completed }}</label>
                                <div class="col-sm-9">
                                    <select name="payment_alfabank_order_status_completed_id" id="input-order-status-completed" class="form-control">
                                        {% for order_status in order_statuses %}

                                            {% if order_status.order_status_id == payment_alfabank_order_status_completed_id %}
                                                <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                                            {% else %}
                                                <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>

                            {% if (enable_refund_options) %}
                                <div class="form-group">
                                    <label class="col-sm-3 control-label" for="input-order-status-reversed">{{ entry_order_status_reversed }}</label>
                                    <div class="col-sm-9">
                                        <select name="payment_alfabank_order_status_reversed_id" id="input-order-status-reversed" class="form-control">
                                            {% for order_status in order_statuses %}

                                                {% if order_status.order_status_id == payment_alfabank_order_status_reversed_id %}
                                                    <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                                                {% else %}
                                                    <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label" for="input-order-status-refunded">{{ entry_order_status_refunded }}</label>
                                    <div class="col-sm-9">
                                        <select name="payment_alfabank_order_status_refunded_id" id="input-order-status-refunded" class="form-control">
                                            {% for order_status in order_statuses %}

                                                {% if order_status.order_status_id == payment_alfabank_order_status_refunded_id %}
                                                    <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                                                {% else %}
                                                    <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            {% endif %}



                            {% if (enable_back_url_settings) %}
                                <!-- backToShopURL -->
                                <div class="form-group">
                                    <label class="col-sm-3 control-label" for="">
                                        {{ entry_backToShopURL }}
                                    </label>
                                    <div class="col-sm-9">
                                        <input type="text" name="payment_alfabank_backToShopURL" value="{{ payment_alfabank_backToShopURL }}" class="form-control" />
                                    </div>
                                </div>
                            {% endif %}

                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    {{ entry_logging }}
                                </label>
                                <div class="col-sm-9">
                                    <select name="payment_alfabank_logging" class="form-control">
                                        <option value="1" {{ payment_alfabank_logging  == 1 ? 'selected="selected"' : '' }}>{{ logging_enabled }}</option>
                                        <option value="0" {{ payment_alfabank_logging  == 0 ? 'selected="selected"' : '' }}>{{ logging_disabled }}</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="">
                                    {{ entry_sortOrder }}
                                </label>
                                <div class="col-sm-9">
                                    <input type="text" name="payment_alfabank_sort_order" value="{{ payment_alfabank_sort_order }}" class="form-control" />
                                </div>
                            </div>

                        </div>


                        {% if (enable_cart_options) %}
                        <div class="tab-pane" id="tab-cart">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        {{ entry_ofdStatus }}
                                    </label>
                                    <div class="col-sm-9">
                                        <select name="payment_alfabank_send_cart" class="form-control">
                                            <option value="1" {{ payment_alfabank_send_cart  == 1 ? 'selected="selected"' : '' }}>{{ entry_ofd_enabled }}</option>
                                            <option value="0" {{ payment_alfabank_send_cart  == 0 ? 'selected="selected"' : '' }}>{{ entry_ofd_disabled }}</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        {{ entry_taxSystem }}
                                    </label>
                                    <div class="col-sm-9">
                                        <select name="payment_alfabank_taxSystem" class="form-control">
                                            {% for taxSystem in taxSystem_list %}
                                                <option value="{{ taxSystem.numeric }}" {{ taxSystem.numeric  == payment_alfabank_taxSystem ? 'selected="selected"' : '' }}>
                                                    {{ taxSystem.numeric  == 0 ? taxSystem.alphabetic : taxSystem.alphabetic }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        {{ entry_taxType }}
                                    </label>
                                    <div class="col-sm-9">
                                        <select name="payment_alfabank_taxType" class="form-control">
                                            {% for taxType in taxType_list %}
                                                <option value="{{ taxType.numeric }}" {{ taxType.numeric  == payment_alfabank_taxType ? 'selected="selected"' : '' }}>
                                                    {{ taxType.numeric  == 0 ? taxType.alphabetic : taxType.alphabetic }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        {{ entry_versionFfdFormat }}
                                    </label>
                                    <div class="col-sm-9">
                                        <select name="payment_alfabank_versionFfd" class="form-control">
                                            {% for versionFfd in versionFfdList %}
                                                <option value="{{ versionFfd.value }}" {{ versionFfd.value  == payment_alfabank_versionFfd ? 'selected="selected"' : '' }}>
                                                    {{ versionFfd.value  == 0 ? versionFfd.title : versionFfd.title }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>

                                <!-- method -->
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        {{ entry_paymentMethod }}
                                    </label>
                                    <div class="col-sm-9">
                                        <select name="payment_alfabank_paymentMethodType" class="form-control">
                                            {% for paymentMethodType in paymentMethodTypeList %}
                                                <option value="{{ paymentMethodType.numeric }}" {{ paymentMethodType.numeric  == payment_alfabank_paymentMethodType ? 'selected="selected"' : '' }}>
                                                    {{ paymentMethodType.value  == 0 ? paymentMethodType.alphabetic : paymentMethodType.alphabetic }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>

                                <!-- method D-->
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        {{ entry_paymentMethodDelivery }}
                                    </label>
                                    <div class="col-sm-9">
                                        <select name="payment_alfabank_paymentMethodTypeDelivery" class="form-control">
                                            {% for paymentMethodType in paymentMethodTypeList %}
                                                <option value="{{ paymentMethodType.numeric }}" {{ paymentMethodType.numeric  == payment_alfabank_paymentMethodTypeDelivery ? 'selected="selected"' : '' }}>
                                                    {{ paymentMethodType.value  == 0 ? paymentMethodType.alphabetic : paymentMethodType.alphabetic }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>

                                <!-- object -->
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        {{ entry_paymentObject }}
                                    </label>
                                    <div class="col-sm-9">
                                        <select name="payment_alfabank_paymentObjectType" class="form-control">
                                            {% for paymentObjectTypeList in paymentObjectTypeListList %}
                                                <option value="{{ paymentObjectTypeList.numeric }}" {{ paymentObjectTypeList.numeric  == payment_alfabank_paymentObjectType ? 'selected="selected"' : '' }}>
                                                    {{ paymentObjectTypeList.value  == 0 ? paymentObjectTypeList.alphabetic : paymentObjectTypeList.alphabetic }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>

                        </div>
                        {% endif %}






                        <div class="tab-pane" id="tab-miscellaneous">

                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="">
                                    {{ entry_minAmount }}
                                </label>
                                <div class="col-sm-9">
                                    <input type="text" name="payment_alfabank_min_amount" value="{{ payment_alfabank_min_amount }}" class="form-control" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="">
                                    {{ entry_maxAmount }}
                                </label>
                                <div class="col-sm-9">
                                    <input type="text" name="payment_alfabank_max_amount" value="{{ payment_alfabank_max_amount }}" class="form-control" />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">{{ entry_customer_group }}</label>
                                <div class="col-sm-9">
                                    <div class="well well-sm" style="height: 150px; overflow: auto;">
                                        {% for customer_group in customer_groups %}
                                        <div class="checkbox">
                                            <label>
                                                {% if payment_alfabank_customer_group_id and customer_group.customer_group_id in payment_alfabank_customer_group_id %}
                                                <input type="checkbox" name="payment_alfabank_customer_group_id[]" value="{{ customer_group.customer_group_id }}" checked="checked" />
                                                {{ customer_group.name }}
                                                {% else %}
                                                <input type="checkbox" name="payment_alfabank_customer_group_id[]" value="{{ customer_group.customer_group_id }}" />
                                                {{ customer_group.name }}
                                                {% endif %}
                                            </label>
                                        </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                {#                        <label class="col-sm-3 control-label" for="input-category"><span data-toggle="tooltip" title="{{ help_category }}">{{ entry_allowed_categories }}</span></label>#}
                                <label class="col-sm-3 control-label" for="input-category">{{ entry_allowed_categories }}</label>
                                <div class="col-sm-9">
                                    <input type="text" name="category" value="" placeholder="{{ entry_category }}" id="input-category" class="form-control"/>
                                    <div id="enabled-category" class="well well-sm" style="height: 150px; overflow: auto;"> {% for enabled_category in enabled_categories %}
                                            <div id="enabled-category{{ enabled_category.category_id }}"><i class="fa fa-minus-circle"></i> {{ enabled_category.name }}
                                                <input type="hidden" name="enabled_category[]" value="{{ enabled_category.category_id }}"/>
                                            </div>
                                        {% endfor %}</div>
                                </div>
                            </div>


                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="input-category-denied">{{ entry_denied_categories }}</label>
                                <div class="col-sm-9">
                                    <input type="text" name="category_denied" value="" placeholder="{{ entry_category }}" id="input-category-denied" class="form-control"/>
                                    <div id="denied-category" class="well well-sm" style="height: 150px; overflow: auto;">
                                        {% for denied_category in denied_categories %}
                                            <div id="denied-category{{ denied_category.category_id }}">
                                                <i class="fa fa-minus-circle"></i> {{ denied_category.name }}
                                                <input type="hidden" name="denied_category[]" value="{{ denied_category.category_id }}"/>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>


                        </div>


                    </div>













                </form>
            </div>
        </div>
    </div>
</div>
{{ footer }}




<script type="text/javascript"><!--


    // Category
    $('input[name=\'category\']').autocomplete({
        'source': function(request, response) {
            $.ajax({
                url: 'index.php?route=catalog/category/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
                dataType: 'json',
                success: function(json) {
                    response($.map(json, function(item) {
                        return {
                            label: item['name'],
                            value: item['category_id']
                        }
                    }));
                }
            });
        },
        'select': function(item) {
            $('input[name=\'category\']').val('');

            $('#enabled-category' + item['value']).remove();

            $('#enabled-category').append('<div id="enabled-category' + item['value'] + '"><i class="fa fa-minus-circle"></i> ' + item['label'] + '<input type="hidden" name="enabled_category[]" value="' + item['value'] + '" /></div>');
        }
    });

    $('#enabled-category').delegate('.fa-minus-circle', 'click', function() {
        $(this).parent().remove();
    });

    // Denied Category
    $('input[name=\'category_denied\']').autocomplete({
        'source': function(request, response) {
            $.ajax({
                url: 'index.php?route=catalog/category/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
                dataType: 'json',
                success: function(json) {
                    response($.map(json, function(item) {
                        return {
                            label: item['name'],
                            value: item['category_id']
                        }
                    }));
                }
            });
        },
        'select': function(item) {
            $('input[name=\'category_denied\']').val('');

            $('#denied-category' + item['value']).remove();

            $('#denied-category').append(
                '<div id="denied-category' + item['value'] + '"><i class="fa fa-minus-circle"></i> ' + item['label'] +
                '<input type="hidden" name="denied_category[]" value="' + item['value'] + '" /></div>'
            );
        }
    });

    $('#denied-category').delegate('.fa-minus-circle', 'click', function() {
        $(this).parent().remove();
    });



    //--></script>


<script type="text/javascript"><!--
    $(document).ready(function() {
        $('#alfabank-tabs a:first').tab('show');
    });
//--></script>