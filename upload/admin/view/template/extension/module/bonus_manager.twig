{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-bonus-manager" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-bonus-manager" class="form-horizontal">

          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
            <li><a href="#tab-bonus-settings" data-toggle="tab">{{ tab_bonus_settings }}</a></li>
            <li><a href="#tab-loyalty-levels" data-toggle="tab">{{ tab_loyalty_levels }}</a></li>
            <li><a href="#tab-notifications" data-toggle="tab">{{ tab_notifications }}</a></li>
            <li><a href="#tab-statistics" data-toggle="tab">{{ tab_statistics }}</a></li>
          </ul>

          <div class="tab-content">
            <!-- General Settings Tab -->
            <div class="tab-pane active" id="tab-general">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-status"><span data-toggle="tooltip" title="{{ help_status }}">{{ entry_status }}</span></label>
                <div class="col-sm-10">
                  <select name="module_bonus_manager_status" id="input-status" class="form-control">
                    {% if module_bonus_manager_status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-discount-threshold"><span data-toggle="tooltip" title="{{ help_discount_threshold }}">{{ entry_discount_threshold }}</span></label>
                <div class="col-sm-10">
                  <div class="input-group">
                    <input type="text" name="module_bonus_manager_discount_threshold" value="{{ module_bonus_manager_discount_threshold }}" placeholder="15" id="input-discount-threshold" class="form-control" />
                    <span class="input-group-addon">%</span>
                  </div>
                  <p class="help-block">{{ help_discount_threshold }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-max-usage-percent"><span data-toggle="tooltip" title="{{ help_max_usage_percent }}">{{ entry_max_usage_percent }}</span></label>
                <div class="col-sm-10">
                  <div class="input-group">
                    <input type="text" name="module_bonus_manager_max_usage_percent" value="{{ module_bonus_manager_max_usage_percent }}" placeholder="30" id="input-max-usage-percent" class="form-control" />
                    <span class="input-group-addon">%</span>
                  </div>
                  <p class="help-block">{{ help_max_usage_percent }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-expiration-days"><span data-toggle="tooltip" title="{{ help_expiration_days }}">{{ entry_expiration_days }}</span></label>
                <div class="col-sm-10">
                  <input type="text" name="module_bonus_manager_expiration_days" value="{{ module_bonus_manager_expiration_days }}" placeholder="365" id="input-expiration-days" class="form-control" />
                  <p class="help-block">{{ help_expiration_days }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-birthday-bonus-amount"><span data-toggle="tooltip" title="Amount of bonus points awarded to customers on their birthday">Birthday Bonus Amount</span></label>
                <div class="col-sm-10">
                  <div class="input-group">
                    <input type="number" name="module_bonus_manager_birthday_bonus_amount" value="{{ module_bonus_manager_birthday_bonus_amount }}" placeholder="500" id="input-birthday-bonus-amount" class="form-control" min="0" />
                    <span class="input-group-addon">&#8381;</span>
                  </div>
                  <p class="help-block">Bonus points awarded to customers on their birthday. Set to 0 to disable birthday bonuses. Only customers in bonus-eligible groups will receive birthday bonuses.</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-accrual-status"><span data-toggle="tooltip" title="{{ help_accrual_status }}">{{ entry_accrual_status }}</span></label>
                <div class="col-sm-10">
                  <select name="module_bonus_manager_accrual_status_id" id="input-accrual-status" class="form-control">
                    {% for order_status in order_statuses %}
                    {% if order_status.order_status_id == module_bonus_manager_accrual_status_id %}
                    <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                    {% else %}
                    <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                    {% endif %}
                    {% endfor %}
                  </select>
                  <p class="help-block">{{ help_accrual_status }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-return-deduction-status"><span data-toggle="tooltip" title="{{ help_return_deduction_status }}">{{ entry_return_deduction_status }}</span></label>
                <div class="col-sm-10">
                  <select name="module_bonus_manager_return_deduction_status_id" id="input-return-deduction-status" class="form-control">
                    {% for return_status in return_statuses %}
                    {% if return_status.return_status_id == module_bonus_manager_return_deduction_status_id %}
                    <option value="{{ return_status.return_status_id }}" selected="selected">{{ return_status.name }}</option>
                    {% else %}
                    <option value="{{ return_status.return_status_id }}">{{ return_status.name }}</option>
                    {% endif %}
                    {% endfor %}
                  </select>
                  <p class="help-block">{{ help_return_deduction_status }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-category"><span data-toggle="tooltip" title="{{ help_excluded_categories }}">{{ entry_excluded_categories }}</span></label>
                <div class="col-sm-10">
                  <input type="text" name="category" value="" placeholder="{{ entry_excluded_categories }}" id="input-category" class="form-control" />
                  <div id="bonus-category" class="well well-sm" style="height: 150px; overflow: auto;">
                    {% for category in excluded_categories %}
                    <div id="bonus-category{{ category.category_id }}"><i class="fa fa-minus-circle"></i> {{ category.name }}
                      <input type="hidden" name="module_bonus_manager_excluded_categories[]" value="{{ category.category_id }}" />
                    </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>

            <!-- Bonus Settings Tab -->
            <div class="tab-pane" id="tab-bonus-settings">
              <div class="well">
                <div class="row">
                  <div class="col-sm-3">
                    <select id="new-customer-group" class="form-control">
                      <option value="">-- {{ entry_customer_group }} --</option>
                      {% for group in customer_groups %}
                      <option value="{{ group.customer_group_id }}">{{ group.name }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div class="col-sm-4">
                    <input type="text" id="new-category" placeholder="{{ entry_category }} (0 = {{ text_all_categories }})" class="form-control" value="0" />
                  </div>
                  <div class="col-sm-3">
                    <div class="input-group">
                      <input type="text" id="new-bonus-percent" placeholder="{{ entry_bonus_percent }}" class="form-control" />
                      <span class="input-group-addon">%</span>
                    </div>
                  </div>
                  <div class="col-sm-2">
                    <button type="button" id="btn-add-bonus-setting" class="btn btn-primary btn-block"><i class="fa fa-plus"></i> {{ button_add_setting }}</button>
                  </div>
                </div>
              </div>

              <div class="table-responsive">
                <table class="table table-bordered table-hover">
                  <thead>
                    <tr>
                      <td class="text-left">{{ column_customer_group }}</td>
                      <td class="text-left">{{ column_category }}</td>
                      <td class="text-right">{{ column_bonus_percent }}</td>
                      <td class="text-right">{{ column_action }}</td>
                    </tr>
                  </thead>
                  <tbody id="bonus-settings-table">
                    {% for setting in bonus_settings %}
                    <tr id="bonus-setting-{{ setting.bonus_setting_id }}">
                      <td class="text-left">{{ setting.group_name }}</td>
                      <td class="text-left">{% if setting.category_id == 0 %}{{ text_all_categories }}{% else %}{{ setting.category_id }}{% endif %}</td>
                      <td class="text-right">{{ setting.bonus_percent }}%</td>
                      <td class="text-right">
                        <button type="button" class="btn btn-danger btn-xs" onclick="deleteBonusSetting({{ setting.bonus_setting_id }});"><i class="fa fa-trash"></i></button>
                      </td>
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Loyalty Levels Tab -->
            <div class="tab-pane" id="tab-loyalty-levels">
              <div class="alert alert-info">
                <i class="fa fa-info-circle"></i> Configure automatic customer group upgrades based on annual spending thresholds. Customers will be automatically upgraded when they reach the threshold within the current program period.
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-loyalty-status">
                  <span data-toggle="tooltip" title="{{ help_loyalty_status }}">{{ entry_loyalty_status }}</span>
                </label>
                <div class="col-sm-10">
                  <select name="module_bonus_manager_loyalty_status" id="input-loyalty-status" class="form-control">
                    {% if module_bonus_manager_loyalty_status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-loyalty-info-page">{{ entry_loyalty_info_page }}</label>
                <div class="col-sm-10">
                  <select name="module_bonus_manager_loyalty_info_id" id="input-loyalty-info-page" class="form-control">
                    <option value="">-- None --</option>
                    {% for page in information_pages %}
                    <option value="{{ page.information_id }}" {% if page.information_id == module_bonus_manager_loyalty_info_id %}selected="selected"{% endif %}>{{ page.title }}</option>
                    {% endfor %}
                  </select>
                  <p class="help-block">Select the information page that describes your loyalty program levels</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-loyalty-period-start">
                  <span data-toggle="tooltip" title="{{ help_loyalty_period_start }}">{{ entry_loyalty_period_start }}</span>
                </label>
                <div class="col-sm-10">
                  <input type="text" name="module_bonus_manager_loyalty_period_start" value="{{ module_bonus_manager_loyalty_period_start }}" placeholder="01-01" id="input-loyalty-period-start" class="form-control" />
                  <p class="help-block">{{ help_loyalty_period_start }}</p>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label">
                  <span data-toggle="tooltip" title="{{ help_loyalty_levels }}">{{ entry_loyalty_levels }}</span>
                </label>
                <div class="col-sm-10">
                  <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="loyalty-levels-table">
                      <thead>
                        <tr>
                          <td class="text-left">{{ entry_customer_group }}</td>
                          <td class="text-left">Display Name (for emails)</td>
                          <td class="text-right">{{ entry_min_total_spent }}</td>
                          <td class="text-center">Action</td>
                        </tr>
                      </thead>
                      <tbody id="loyalty-levels-tbody">
                        {% if loyalty_levels %}
                          {% for level in loyalty_levels %}
                        <tr>
                          <td class="text-left">
                            <select name="module_bonus_manager_loyalty_levels[{{ loop.index0 }}][customer_group_id]" class="form-control">
                              {% for group in customer_groups %}
                              <option value="{{ group.customer_group_id }}" {% if group.customer_group_id == level.customer_group_id %}selected="selected"{% endif %}>{{ group.name }}</option>
                              {% endfor %}
                            </select>
                          </td>
                          <td class="text-left">
                            <input type="text" name="module_bonus_manager_loyalty_levels[{{ loop.index0 }}][display_name]" value="{{ level.display_name|default('') }}" placeholder="e.g., Silver, Gold, Platinum" class="form-control" />
                          </td>
                          <td class="text-right">
                            <input type="number" name="module_bonus_manager_loyalty_levels[{{ loop.index0 }}][min_total_spent]" value="{{ level.min_total_spent }}" placeholder="0" class="form-control" />
                          </td>
                          <td class="text-center">
                            <button type="button" onclick="removeLoyaltyLevel(this);" class="btn btn-danger btn-xs"><i class="fa fa-minus-circle"></i></button>
                          </td>
                        </tr>
                          {% endfor %}
                        {% else %}
                        <tr>
                          <td class="text-left">
                            <select name="module_bonus_manager_loyalty_levels[0][customer_group_id]" class="form-control">
                              {% for group in customer_groups %}
                              <option value="{{ group.customer_group_id }}">{{ group.name }}</option>
                              {% endfor %}
                            </select>
                          </td>
                          <td class="text-left">
                            <input type="text" name="module_bonus_manager_loyalty_levels[0][display_name]" value="" placeholder="e.g., Silver, Gold, Platinum" class="form-control" />
                          </td>
                          <td class="text-right">
                            <input type="number" name="module_bonus_manager_loyalty_levels[0][min_total_spent]" value="0" placeholder="0" class="form-control" />
                          </td>
                          <td class="text-center">
                            <button type="button" onclick="removeLoyaltyLevel(this);" class="btn btn-danger btn-xs"><i class="fa fa-minus-circle"></i></button>
                          </td>
                        </tr>
                        {% endif %}
                      </tbody>
                      <tfoot>
                        <tr>
                          <td colspan="4"><button type="button" onclick="addLoyaltyLevel();" class="btn btn-primary"><i class="fa fa-plus-circle"></i> {{ text_add_level }}</button></td>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                  <p class="help-block">{{ help_loyalty_levels }}</p>
                </div>
              </div>
            </div>

            <!-- Notifications Tab -->
            <div class="tab-pane" id="tab-notifications">
              <p class="help-block"><i class="fa fa-info-circle"></i> {{ help_notification_email }}</p>
              <hr/>

              <style>
                .email-preview-container {
                  border: 1px solid #ddd;
                  border-radius: 4px;
                  margin-bottom: 15px;
                  background: #fff;
                }
                .email-preview-header {
                  background: #f5f5f5;
                  padding: 10px 15px;
                  border-bottom: 1px solid #ddd;
                  display: flex;
                  justify-content: space-between;
                  align-items: center;
                }
                .email-preview-header .subject-preview {
                  font-weight: bold;
                  color: #333;
                }
                .email-preview-frame {
                  padding: 20px;
                  min-height: 200px;
                  max-height: 400px;
                  overflow-y: auto;
                  background: #fff;
                }
                .email-editor-container {
                  display: none;
                  padding: 15px;
                  background: #fafafa;
                  border-top: 1px solid #ddd;
                }
                .email-editor-container.active {
                  display: block;
                }
                .btn-edit-email {
                  padding: 4px 12px;
                  font-size: 12px;
                }
                .btn-edit-email .fa {
                  margin-right: 4px;
                }
                .email-preview-frame iframe {
                  width: 100%;
                  border: none;
                  min-height: 200px;
                }
              </style>

              <!-- Bonus Awarded Notification -->
              <fieldset>
                <legend>{{ entry_email_awarded_status }}</legend>

                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-email-awarded-status"><span data-toggle="tooltip" title="{{ help_email_awarded_status }}">{{ entry_status }}</span></label>
                  <div class="col-sm-10">
                    <select name="module_bonus_manager_email_awarded_status" id="input-email-awarded-status" class="form-control">
                      {% if module_bonus_manager_email_awarded_status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-email-awarded-subject"><span data-toggle="tooltip" title="{{ help_email_awarded_subject }}">{{ entry_email_awarded_subject }}</span></label>
                  <div class="col-sm-10">
                    <input type="text" name="module_bonus_manager_email_awarded_subject" value="{{ module_bonus_manager_email_awarded_subject }}" placeholder="Вам начислены бонусы за заказ #{order_id}" id="input-email-awarded-subject" class="form-control" />
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_email_awarded_body }}">{{ entry_email_awarded_body }}</span></label>
                  <div class="col-sm-10">
                    <div class="email-preview-container" id="preview-container-awarded">
                      <div class="email-preview-header">
                        <span class="subject-preview" id="subject-preview-awarded">{{ module_bonus_manager_email_awarded_subject|default('Вам начислены бонусы за заказ #{order_id}') }}</span>
                        <button type="button" class="btn btn-default btn-edit-email" onclick="toggleEmailEditor('awarded');">
                          <i class="fa fa-code"></i> Edit HTML
                        </button>
                      </div>
                      <div class="email-preview-frame" id="preview-frame-awarded">
                        {{ module_bonus_manager_email_awarded_body|raw }}
                      </div>
                      <div class="email-editor-container" id="editor-container-awarded">
                        <textarea name="module_bonus_manager_email_awarded_body" rows="12" id="input-email-awarded-body" class="form-control" onchange="updateEmailPreview('awarded');">{{ module_bonus_manager_email_awarded_body|raw }}</textarea>
                        <button type="button" class="btn btn-success btn-sm" style="margin-top: 10px;" onclick="toggleEmailEditor('awarded');">
                          <i class="fa fa-eye"></i> Preview
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </fieldset>

              <hr/>

              <!-- Bonus Spent Notification -->
              <fieldset>
                <legend>{{ entry_email_spent_status }}</legend>

                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-email-spent-status"><span data-toggle="tooltip" title="{{ help_email_spent_status }}">{{ entry_status }}</span></label>
                  <div class="col-sm-10">
                    <select name="module_bonus_manager_email_spent_status" id="input-email-spent-status" class="form-control">
                      {% if module_bonus_manager_email_spent_status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-email-spent-subject"><span data-toggle="tooltip" title="{{ help_email_spent_subject }}">{{ entry_email_spent_subject }}</span></label>
                  <div class="col-sm-10">
                    <input type="text" name="module_bonus_manager_email_spent_subject" value="{{ module_bonus_manager_email_spent_subject }}" placeholder="Списаны бонусы за заказ #{order_id}" id="input-email-spent-subject" class="form-control" />
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_email_spent_body }}">{{ entry_email_spent_body }}</span></label>
                  <div class="col-sm-10">
                    <div class="email-preview-container" id="preview-container-spent">
                      <div class="email-preview-header">
                        <span class="subject-preview" id="subject-preview-spent">{{ module_bonus_manager_email_spent_subject|default('Списаны бонусы за заказ #{order_id}') }}</span>
                        <button type="button" class="btn btn-default btn-edit-email" onclick="toggleEmailEditor('spent');">
                          <i class="fa fa-code"></i> Edit HTML
                        </button>
                      </div>
                      <div class="email-preview-frame" id="preview-frame-spent">
                        {{ module_bonus_manager_email_spent_body|raw }}
                      </div>
                      <div class="email-editor-container" id="editor-container-spent">
                        <textarea name="module_bonus_manager_email_spent_body" rows="12" id="input-email-spent-body" class="form-control" onchange="updateEmailPreview('spent');">{{ module_bonus_manager_email_spent_body|raw }}</textarea>
                        <button type="button" class="btn btn-success btn-sm" style="margin-top: 10px;" onclick="toggleEmailEditor('spent');">
                          <i class="fa fa-eye"></i> Preview
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </fieldset>

              <!-- Bonus Deducted Notification (Return) -->
              <fieldset>
                <legend>{{ entry_email_deducted_status }}</legend>

                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-email-deducted-status"><span data-toggle="tooltip" title="{{ help_email_deducted_status }}">{{ entry_status }}</span></label>
                  <div class="col-sm-10">
                    <select name="module_bonus_manager_email_deducted_status" id="input-email-deducted-status" class="form-control">
                      {% if module_bonus_manager_email_deducted_status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-email-deducted-subject"><span data-toggle="tooltip" title="{{ help_email_deducted_subject }}">{{ entry_email_deducted_subject }}</span></label>
                  <div class="col-sm-10">
                    <input type="text" name="module_bonus_manager_email_deducted_subject" value="{{ module_bonus_manager_email_deducted_subject }}" placeholder="Бонусные баллы списаны - {store_name}" id="input-email-deducted-subject" class="form-control" />
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_email_deducted_body }}">{{ entry_email_deducted_body }}</span></label>
