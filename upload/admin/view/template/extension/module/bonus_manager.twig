<script type="text/javascript">
// Category autocomplete
$('input[name=\'category\']').autocomplete({
  source: function(request, response) {
    $.ajax({
      url: 'index.php?route=catalog/category/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
      dataType: 'json',
      success: function(json) {
        response($.map(json, function(item) {
          return {
            label: item['name'],
            value: item['category_id']
          }
        }));
      }
    });
  },
  select: function(item) {
    $('input[name=\'category\']').val('');

    $('#bonus-category' + item['value']).remove();

    $('#bonus-category').append('<div id="bonus-category' + item['value'] + '"><i class="fa fa-minus-circle"></i> ' + item['label'] + '<input type="hidden" name="module_bonus_manager_excluded_categories[]" value="' + item['value'] + '" /></div>');
  }
});

$('#bonus-category').delegate('.fa-minus-circle', 'click', function() {
  $(this).parent().remove();
});

// Add bonus setting
$('#btn-add-bonus-setting').on('click', function() {
  var customer_group_id = $('#new-customer-group').val();
  var category_id = $('#new-category').val();
  var bonus_percent = $('#new-bonus-percent').val();

  if (!customer_group_id) {
    alert('Please select a customer group');
    return;
  }

  if (!bonus_percent || bonus_percent < 0) {
    alert('Please enter a valid bonus percentage');
    return;
  }

  $.ajax({
    url: 'index.php?route=extension/module/bonus_manager/addBonusSetting&user_token={{ user_token }}',
    type: 'post',
    data: {
      customer_group_id: customer_group_id,
      category_id: category_id || 0,
      bonus_percent: bonus_percent
    },
    dataType: 'json',
    beforeSend: function() {
      $('#btn-add-bonus-setting').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Adding...');
    },
    success: function(json) {
      $('#btn-add-bonus-setting').prop('disabled', false).html('<i class="fa fa-plus"></i> {{ button_add_setting }}');

      if (json['error']) {
        alert(json['error']);
      }

      if (json['success']) {
        alert(json['success']);
        location.reload();
      }
    },
    error: function(xhr, ajaxOptions, thrownError) {
      $('#btn-add-bonus-setting').prop('disabled', false).html('<i class="fa fa-plus"></i> {{ button_add_setting }}');

      if (xhr.responseText && xhr.responseText.indexOf('<!DOCTYPE') !== -1) {
        alert('Session expired. Please refresh the page and login again.');
        location.reload();
      } else {
        alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
      }
    }
  });
});

// Delete bonus setting
function deleteBonusSetting(bonus_setting_id) {
  if (confirm('Are you sure?')) {
    $.ajax({
      url: 'index.php?route=extension/module/bonus_manager/deleteBonusSetting&user_token={{ user_token }}',
      type: 'post',
      data: {
        bonus_setting_id: bonus_setting_id
      },
      dataType: 'json',
      beforeSend: function() {
        $('#bonus-setting-' + bonus_setting_id).css('opacity', '0.5');
      },
      success: function(json) {
        if (json['error']) {
          alert(json['error']);
          $('#bonus-setting-' + bonus_setting_id).css('opacity', '1');
        }

        if (json['success']) {
          $('#bonus-setting-' + bonus_setting_id).remove();
          alert('Bonus setting deleted successfully');
        }
      },
      error: function(xhr, ajaxOptions, thrownError) {
        $('#bonus-setting-' + bonus_setting_id).css('opacity', '1');
        if (xhr.responseText && xhr.responseText.indexOf('<!DOCTYPE') !== -1) {
          alert('Session expired. Please refresh the page and login again.');
          location.reload();
        } else {
          alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
      }
    });
  }
}

// Loyalty Levels Management
var loyalty_level_row = {{ loyalty_levels|length|default(1) }};

function addLoyaltyLevel() {
  var html = '<tr>';
  html += '  <td class="text-left">';
  html += '    <select name="module_bonus_manager_loyalty_levels[' + loyalty_level_row + '][customer_group_id]" class="form-control">';
  {% for group in customer_groups %}
  html += '      <option value="{{ group.customer_group_id }}">{{ group.name }}</option>';
  {% endfor %}
  html += '    </select>';
  html += '  </td>';
  html += '  <td class="text-left">';
  html += '    <input type="text" name="module_bonus_manager_loyalty_levels[' + loyalty_level_row + '][display_name]" value="" placeholder="e.g., Silver, Gold, Platinum" class="form-control" />';
  html += '  </td>';
  html += '  <td class="text-right">';
  html += '    <input type="number" name="module_bonus_manager_loyalty_levels[' + loyalty_level_row + '][min_total_spent]" value="0" placeholder="0" class="form-control" />';
  html += '  </td>';
  html += '  <td class="text-center">';
  html += '    <button type="button" onclick="removeLoyaltyLevel(this);" class="btn btn-danger btn-xs"><i class="fa fa-minus-circle"></i></button>';
  html += '  </td>';
  html += '</tr>';

  $('#loyalty-levels-tbody').append(html);
  loyalty_level_row++;
}

function removeLoyaltyLevel(element) {
  if ($('#loyalty-levels-tbody tr').length > 1) {
    $(element).closest('tr').remove();
  } else {
    alert('You must have at least one loyalty level');
  }
}

// Email Preview/Edit Toggle Functions
function toggleEmailEditor(type) {
  var editorContainer = $('#editor-container-' + type);
  var previewFrame = $('#preview-frame-' + type);
  var editButton = $('#preview-container-' + type + ' .btn-edit-email');

  if (editorContainer.hasClass('active')) {
    // Switch to preview mode
    editorContainer.removeClass('active');
    previewFrame.show();
    editButton.html('<i class="fa fa-code"></i> Edit HTML');

    // Update preview with current textarea content
    updateEmailPreview(type);
  } else {
    // Switch to edit mode
    editorContainer.addClass('active');
    previewFrame.hide();
    editButton.html('<i class="fa fa-eye"></i> Preview');
  }
}

function updateEmailPreview(type) {
  var textareaId = 'input-email-' + type + '-body';
  if (type === 'loyalty-upgrade') {
    textareaId = 'input-email-loyalty-upgrade-body';
  }

  var textarea = $('#' + textareaId);
  var previewFrame = $('#preview-frame-' + type);

  if (textarea.length && previewFrame.length) {
    previewFrame.html(textarea.val());
  }
}

