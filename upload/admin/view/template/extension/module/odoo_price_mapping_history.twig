{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_history_list }}</h3>
            </div>

            <div class="panel-body">
                <div class="well">
                    {% if product_id is not defined %}
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label class="control-label" for="input-product-id">{{ entry_product_id }}</label>
                                <input type="text" name="filter_product_id" value="{{ filters.filter_product_id ?? '' }}" placeholder="{{ entry_product_id }}" id="input-product-id" class="form-control" />
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label class="control-label" for="input-product-model">{{ entry_model }}</label>
                                <input type="text" name="filter_model" value="{{ filters.filter_model ?? '' }}" placeholder="{{ entry_model }}" id="input-product-model" class="form-control" />
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label class="control-label" for="input-product-name">{{ entry_product_name }}</label>
                                <input type="text" name="filter_product_name" value="{{ filters.filter_product_name ?? '' }}" placeholder="{{ entry_product_name }}" id="input-product-name" class="form-control" />
                            </div>
                        </div>
                    </div>
                    {% endif %}
                    <div class="row">
                        {% if product_id is defined %}
                        <div class="col-sm-5">
                            <div class="form-group">
                                <label class="control-label" for="input-status">{{ entry_status }}</label>
                                <select name="filter_status" id="input-status" class="form-control">
                                    <option value="">{{ text_all }}</option>
                                    <option value="synced"{% if filters.filter_status is defined and filters.filter_status == 'synced' %} selected="selected"{% endif %}>{{ text_status_synced }}</option>
                                    <option value="pending"{% if filters.filter_status is defined and filters.filter_status == 'pending' %} selected="selected"{% endif %}>{{ text_status_pending }}</option>
                                    <option value="error"{% if filters.filter_status is defined and filters.filter_status == 'error' %} selected="selected"{% endif %}>{{ text_status_error }}</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-5">
                            <div class="form-group">
                                <label class="control-label" for="input-customer-group">{{ entry_customer_group }}</label>
                                <select name="filter_customer_group_id" id="input-customer-group" class="form-control">
                                    <option value="">{{ text_all }}</option>
                                    {% for customer_group in customer_groups %}
                                    <option value="{{ customer_group.customer_group_id }}"{% if filters.filter_customer_group_id is defined and filters.filter_customer_group_id == customer_group.customer_group_id %} selected="selected"{% endif %}>{{ customer_group.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            {% else %}
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label class="control-label" for="input-status">{{ entry_status }}</label>
                                    <select name="filter_status" id="input-status" class="form-control">
                                        <option value="">{{ text_all }}</option>
                                        <option value="synced"{% if filters.filter_status is defined and filters.filter_status == 'synced' %} selected="selected"{% endif %}>{{ text_status_synced }}</option>
                                        <option value="pending"{% if filters.filter_status is defined and filters.filter_status == 'pending' %} selected="selected"{% endif %}>{{ text_status_pending }}</option>
                                        <option value="error"{% if filters.filter_status is defined and filters.filter_status == 'error' %} selected="selected"{% endif %}>{{ text_status_error }}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-8">
                                {% endif %}
                                <div class="form-group" style="margin-top: 23px;">
                                    <button type="button" id="button-filter" class="btn btn-primary pull-right"><i class="fa fa-filter"></i> {{ button_filter }}</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead>
                            <tr>
                                {% if product_id is not defined %}
                                <td class="text-left">{{ column_product }}</td>
                                <td class="text-left">{{ column_product_name }}</td>
                                {% endif %}
                                {% if product_id is defined %}
                                <td class="text-left">{{ column_customer_group }}</td>
                                {% endif %}
                                <td class="text-right">{{ column_old_price }}</td>
                                <td class="text-right">{{ column_new_price }}</td>
                                <td class="text-left">{{ column_sync_direction }}</td>
                                <td class="text-left">{{ column_status }}</td>
                                <td class="text-left">{{ column_message }}</td>
                                <td class="text-left">{{ column_date }}</td>
                            </tr>
                            </thead>
                            <tbody>
                            {% if sync_history %}
                            {% for history in sync_history %}
                            <tr>
                                {% if product_id is not defined %}
                                <td class="text-left">{{ history.product_id }}</td>
                                <td class="text-left">
                                    {{ history.product_name }}
                                    <br/>
                                    <small>{{ history.product_model }}</small>
                                </td>
                                {% endif %}
                                {% if product_id is defined %}
                                <td class="text-left">
                                    {% if history.customer_group_name %}
                                    {{ history.customer_group_name }}
                                    {% if history.odoo_pricelist_name %}
                                    <br/>
                                    <small>{{ history.odoo_pricelist_name }}</small>
                                    {% endif %}
                                    {% endif %}
                                </td>
                                {% endif %}
                                <td class="text-right">{{ history.old_price }}</td>
                                <td class="text-right">{{ history.new_price }}</td>
                                <td class="text-left">
                                    {% if history.sync_direction == 'to_odoo' %}
                                    <span class="label label-info">{{ text_direction_to_odoo }}</span>
                                    {% else %}
                                    <span class="label label-warning">{{ text_direction_from_odoo }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-left">
                                    {% if history.status == 'synced' %}
                                    <span class="label label-success">{{ text_status_synced }}</span>
                                    {% elseif history.status == 'pending' %}
                                    <span class="label label-warning">{{ text_status_pending }}</span>
                                    {% else %}
                                    <span class="label label-danger">{{ text_status_error }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-left">{{ history.formatted_message }}</td>
                                <td class="text-left">{{ history.created_on }}</td>
                            </tr>
                            {% endfor %}
                            {% else %}
                            <tr>
                                <td class="text-center" colspan="{% if product_id is defined %}7{% else %}8{% endif %}">{{ text_no_results }}</td>
                            </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 text-left">{{ pagination }}</div>
                        <div class="col-sm-6 text-right">{{ results }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript"><!--
        $('#button-filter').on('click', function() {
            var url = 'index.php?route=extension/module/odoo_price_mapping/history&user_token={{ user_token }}';

        {% if mapping_id is defined %}
                url += '&mapping_id={{ mapping_id }}';
            {% endif %}
        {% if product_id is defined %}
                url += '&product_id={{ product_id }}';
            {% endif %}

        {% if product_id is not defined %}
                var filter_product_id = $('input[name=\'filter_product_id\']').val();
                if (filter_product_id) {
                    url += '&filter_product_id=' + encodeURIComponent(filter_product_id);
                }

                var filter_model = $('input[name=\'filter_model\']').val();
                if (filter_model) {
                    url += '&filter_model=' + encodeURIComponent(filter_model);
                }

                var filter_product_name = $('input[name=\'filter_product_name\']').val();
                if (filter_product_name) {
                    url += '&filter_product_name=' + encodeURIComponent(filter_product_name);
                }
            {% endif %}

            var filter_status = $('select[name=\'filter_status\']').val();
            if (filter_status !== '') {
                url += '&filter_status=' + encodeURIComponent(filter_status);
            }

        {% if product_id is defined %}
                var filter_customer_group_id = $('select[name=\'filter_customer_group_id\']').val();
                if (filter_customer_group_id !== '') {
                    url += '&filter_customer_group_id=' + encodeURIComponent(filter_customer_group_id);
                }
            {% endif %}

            location = url;
        });

        // Add Enter key support for all filter inputs
        $(document).ready(function() {
        {% if product_id is not defined %}
                $('#input-product-id, #input-product-model, #input-product-name').keypress(function(e) {
                    if (e.which == 13) {  // Enter key
                        $('#button-filter').trigger('click');
                    }
                });
            {% endif %}
        });
        //--></script>
    {{ footer }}
