{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" data-toggle="tooltip" title="{{ button_filter }}" onclick="$('#filter-operations').toggleClass('hidden-sm hidden-xs');" class="btn btn-default hidden-md hidden-lg"><i class="fa fa-filter"></i></button>
        <a href="{{ dashboard_link }}" class="btn btn-default"><i class="fa fa-reply"></i> {{ text_dashboard }}</a>
      </div>
      <h1>{{ heading_title }} - {{ text_operations }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    <div class="row">
      <div id="filter-operations" class="col-md-3 col-md-push-9 col-sm-12 hidden-sm hidden-xs">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3>
          </div>
          <div class="panel-body">
            <div class="form-group">
              <label class="control-label" for="input-order-id">{{ entry_order_id }}</label>
              <input type="text" name="filter_order_id" value="{{ filter_order_id }}" placeholder="{{ entry_order_id }}" id="input-order-id" class="form-control" />
            </div>
            <div class="form-group">
              <label class="control-label" for="input-customer">{{ entry_customer }}</label>
              <input type="text" name="filter_customer" value="{{ filter_customer }}" placeholder="{{ entry_customer }}" id="input-customer" class="form-control" />
            </div>
            <div class="form-group">
              <label class="control-label" for="input-reward-kind">{{ entry_reward_kind }}</label>
              <select name="filter_reward_kind" id="input-reward-kind" class="form-control">
                <option value=""></option>
                {% for kind in reward_kinds %}
                  <option value="{{ kind }}"{% if filter_reward_kind == kind %} selected="selected"{% endif %}>{{ kind }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="form-group">
              <label class="control-label" for="input-bonus-type">{{ entry_bonus_type }}</label>
              <input type="text" name="filter_bonus_type" value="{{ filter_bonus_type }}" placeholder="{{ entry_bonus_type }}" id="input-bonus-type" class="form-control" />
            </div>
            <div class="form-group">
              <label class="control-label" for="input-points-sign">{{ entry_points_sign }}</label>
              <select name="filter_points_sign" id="input-points-sign" class="form-control">
                <option value=""></option>
                <option value="positive"{% if filter_points_sign == 'positive' %} selected="selected"{% endif %}>+ / Earned</option>
                <option value="negative"{% if filter_points_sign == 'negative' %} selected="selected"{% endif %}>- / Spent</option>
                <option value="zero"{% if filter_points_sign == 'zero' %} selected="selected"{% endif %}>0</option>
              </select>
            </div>
            <div class="form-group">
              <label class="control-label" for="input-date-from">{{ entry_date_from }}</label>
              <div class="input-group date">
                <input type="text" name="filter_date_from" value="{{ filter_date_from }}" placeholder="{{ entry_date_from }}" data-date-format="YYYY-MM-DD" id="input-date-from" class="form-control" />
                <span class="input-group-btn">
                <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
                </span>
              </div>
            </div>
            <div class="form-group">
              <label class="control-label" for="input-date-to">{{ entry_date_to }}</label>
              <div class="input-group date">
                <input type="text" name="filter_date_to" value="{{ filter_date_to }}" placeholder="{{ entry_date_to }}" data-date-format="YYYY-MM-DD" id="input-date-to" class="form-control" />
                <span class="input-group-btn">
                <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
                </span>
              </div>
            </div>
            <div class="form-group text-right">
              <button type="button" id="button-filter" class="btn btn-default"><i class="fa fa-filter"></i> {{ button_filter }}</button>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-9 col-md-pull-3 col-sm-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_operations }}</h3>
          </div>
          <div class="panel-body">
            <p class="text-muted">{{ text_operations_help }}</p>
            <div class="table-responsive">
              <table class="table table-bordered table-hover">
                <thead>
                  <tr>
                    <td class="text-left">{{ column_order_id }}</td>
                    <td class="text-left">{{ column_customer }}</td>
                    <td class="text-left">{{ column_reward_kind }}</td>
                    <td class="text-left">{{ column_bonus_type }}</td>
                    <td class="text-right">{{ column_points }}</td>
                    <td class="text-right">{{ column_remaining }}</td>
                    <td class="text-left">{{ column_date }}</td>
                  </tr>
                </thead>
                <tbody>
                  {% if transactions|length > 0 %}
                    {% for transaction in transactions %}
                      {% set row_link = '' %}
                      {% if transaction.order_id %}
                        {% set row_link = 'index.php?route=sale/order/info&user_token=' ~ user_token ~ '&order_id=' ~ transaction.order_id %}
                      {% elseif transaction.customer_id %}
                        {% set row_link = 'index.php?route=customer/customer/edit&user_token=' ~ user_token ~ '&customer_id=' ~ transaction.customer_id %}
                      {% endif %}
                      <tr{% if row_link %} class="js-row-link" data-href="{{ row_link }}"{% endif %}>
                        <td class="text-left">{% if transaction.order_id %}#{{ transaction.order_id }}{% else %}-{% endif %}</td>
                        <td class="text-left">{{ transaction.customer_name }}<br/><small>{{ transaction.email }}</small></td>
                        <td class="text-left">{{ transaction.reward_kind }}</td>
                        <td class="text-left">{{ transaction.bonus_type }}</td>
                        <td class="text-right">
                          {% if transaction.points >= 0 %}
                            <span class="label label-success">+{{ transaction.points }}</span>
                          {% else %}
                            <span class="label label-danger">{{ transaction.points }}</span>
                          {% endif %}
                        </td>
                        <td class="text-right">
                          {% if transaction.remaining is null %}-{% else %}{{ transaction.remaining }}{% endif %}
                        </td>
                        <td class="text-left">{{ transaction.date_added }}</td>
                      </tr>
                    {% endfor %}
                  {% else %}
                    <tr>
                      <td class="text-center" colspan="7">No transactions.</td>
                    </tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
            <div class="text-right">{{ pagination }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}

<script type="text/javascript">
(function() {
  document.getElementById('button-filter').addEventListener('click', function() {
    var url = 'index.php?route=extension/module/bonus_manager/operations&user_token={{ user_token }}';
    var orderId = document.getElementById('input-order-id').value;
    var customer = document.getElementById('input-customer').value;
    var rewardKind = document.getElementById('input-reward-kind').value;
    var bonusType = document.getElementById('input-bonus-type').value;
    var pointsSign = document.getElementById('input-points-sign').value;
    var dateFrom = document.getElementById('input-date-from').value;
    var dateTo = document.getElementById('input-date-to').value;

    if (orderId) {
      url += '&filter_order_id=' + encodeURIComponent(orderId);
    }
    if (customer) {
      url += '&filter_customer=' + encodeURIComponent(customer);
    }
    if (rewardKind) {
      url += '&filter_reward_kind=' + encodeURIComponent(rewardKind);
    }
    if (bonusType) {
      url += '&filter_bonus_type=' + encodeURIComponent(bonusType);
    }
    if (pointsSign) {
      url += '&filter_points_sign=' + encodeURIComponent(pointsSign);
    }
    if (dateFrom) {
      url += '&filter_date_from=' + encodeURIComponent(dateFrom);
    }
    if (dateTo) {
      url += '&filter_date_to=' + encodeURIComponent(dateTo);
    }

    window.location.href = url;
  });

  var rows = document.querySelectorAll('.js-row-link');
  for (var i = 0; i < rows.length; i++) {
    rows[i].addEventListener('click', function(e) {
      if (e.target && e.target.tagName && e.target.tagName.toLowerCase() === 'a') {
        return;
      }
      var href = this.getAttribute('data-href');
      if (href) {
        window.location.href = href;
      }
    });
  }
})();
</script>
<script src="view/javascript/jquery/datetimepicker/bootstrap-datetimepicker.min.js" type="text/javascript"></script>
<link href="view/javascript/jquery/datetimepicker/bootstrap-datetimepicker.min.css" type="text/css" rel="stylesheet" media="screen" />
<script type="text/javascript"><!--
$('.date').datetimepicker({
  language: '{{ datepicker }}',
  pickTime: false
});
//--></script>
