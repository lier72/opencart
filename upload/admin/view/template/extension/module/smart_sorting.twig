                          </fieldset>
                        
                        {% endfor %}

                      </div>
                      <!-- /.vtabs-content-container -->
                    </div>
                    <!-- /.vtabs -->
                    
                  </div>
                  <!-- /.tab-pane -->
                  
                  <div id="tab-smart-sorting-search" class="tab-pane">

                    <div class="vtabs">
                      <div class="col-sm-3">
                        <ul id="smart-sorting-search-store-tabs" class="vtabs-tab-container nav nav-tabs tabs-left"><!--<ul class="vtabs-tab-container nav nav-pills nav-stacked">-->
                          {% for store in stores %}
                            <li class="{{ store.store_id == 0 ? "active" : "" }}">
                              <a href="#tab-smart-sorting-search-store-{{ store.store_id }}" data-toggle="tab">
                                <span class="{{ module_smart_sorting[store.store_id].search_status == false ? 'red' : '' }}">{{ store.name }}</span>
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                      <!-- .col -->

                      <hr class="hidden-lg hidden-md hidden-sm" />

                      <div class="vtabs-content-container tab-content col-sm-9">
                        
                        {% for store in stores %}
                        
                          <fieldset id="tab-smart-sorting-search-store-{{ store.store_id }}" class="tab-pane {{ store.store_id == 0 ? "active" : "" }}">

                            <legend>{{ store.name }} - {{ text_heading_search }}</legend>

                            <div class="form-group">
                              <label class="col-sm-2 control-label" for="input-store-{{ store.store_id }}-search-status">
                                <span data-toggle="tooltip" title="{{ help_search_status }}">{{ entry_search_status }}</span>
                              </label>
                              <div class="col-sm-10">
                                <div class="row">
                                  <div class="col-sm-6">
                                    <select name="{{ code }}[{{ store.store_id }}][search_status]" id="input-store-{{ store.store_id }}-search-status" class="form-control">
                                      {% if module_smart_sorting[store.store_id].search_status %}
                                      <option value="1" selected="selected">{{ text_enabled }}</option>
                                      <option value="0">{{ text_disabled }}</option>
                                      {% else %}
                                      <option value="1">{{ text_enabled }}</option>
                                      <option value="0" selected="selected">{{ text_disabled }}</option>
                                      {% endif %}
                                    </select>
                                  </div>
                                </div>
                              </div>
                            </div>

                            <hr />

                            <div class="form-group">
