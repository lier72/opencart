                              <div class="col-sm-10">
                                <div class="well well-sm well-scrollable mbm">
                                  <input type="hidden" name="{{ code }}[{{ store.store_id }}][manufacturer_disable_sorting_methods][]" value="" />
                                  {% for manufacturer_sorting_method in manufacturer_sorting_methods %}
                                  <div class="checkbox">
                                    <label>
                                      <input type="checkbox" name="{{ code }}[{{ store.store_id }}][manufacturer_disable_sorting_methods][]" value="{{ manufacturer_sorting_method.value }}" {{ manufacturer_sorting_method.value in module_smart_sorting[store.store_id].manufacturer_disable_sorting_methods ? 'checked' : '' }} />
                                      {{ manufacturer_sorting_method.text }}
                                    </label>
                                  </div>
                                  {% endfor %}
                                </div>
                                <div class="check-uncheck-all-container">
                                  <a href="#" class="well-check-all btn btn-info btn-sm">{{ text_check_all }}</a>
                                  <a href="#" class="well-uncheck-all btn btn-warning btn-sm">{{ text_uncheck_all }}</a>
                                </div>                      
                              </div>
                            </div>

                            <div class="space-10"></div>

                            <div class="form-group">
                              <label class="col-sm-2 control-label" for="input-store-{{ store.store_id }}-manufacturer-default-sort-order">
                                {{ entry_manufacturer_default_sort_order }}
                              </label>
                              <div class="col-sm-10">
                                <div class="row">
                                  <div class="col-sm-6">
                                    <select name="{{ code }}[{{ store.store_id }}][manufacturer_default_sort_order]" id="input-store-{{ store.store_id }}-manufacturer-default-sort-order" class="form-control">
                                      {% for manufacturer_sorting_method in manufacturer_sorting_methods %}
                                        <option value="{{ manufacturer_sorting_method.value }}" {{ manufacturer_sorting_method.value == module_smart_sorting[store.store_id].manufacturer_default_sort_order ? 'selected="selected"' : '' }}>{{ manufacturer_sorting_method.text }}</option>
                                      {% endfor %}
                                    </select>
                                  </div>
                                </div>
                              </div>
                            </div>

                            <hr />
                            
                            <div class="form-group">
                              <label class="col-sm-2 control-label" for="input-store-{{ store.store_id }}-manufacturer-product-limit-status"></label>
                              <div class="col-sm-10">
                                <div class="bs-switch bs-switch-common" data-bs-switch-toggle-target="toggle-store-{{ store.store_id }}-manufacturer-product-limit-status">
                                  <input type="hidden" name="{{ code }}[{{ store.store_id }}][manufacturer_product_limit_status]" value="0" />
                                  <div class="checkbox">
                                    <label>
                                      <input type="checkbox" id="input-store-{{ store.store_id }}-manufacturer-product-limit-status" name="{{ code }}[{{ store.store_id }}][manufacturer_product_limit_status]" value="1" {{ module_smart_sorting[store.store_id].manufacturer_product_limit_status == true ? 'checked' : '' }} />
                                      {{ entry_manufacturer_product_limit_status }}
                                    </label>
                                  </div>
                                </div>
                              </div>
                            </div>                            
                            
                            <div class="{{ module_smart_sorting[store.store_id].manufacturer_product_limit_status == true ? 'open' : 'closed' }}" data-bs-switch-toggle-id="toggle-store-{{ store.store_id }}-manufacturer-product-limit-status">
                            
                              <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-store-{{ store.store_id }}-manufacturer-product-limits">
                                  <span data-toggle="tooltip" title="{{ help_manufacturer_product_limits }}">{{ entry_manufacturer_product_limits }}</span>
                                </label>
                                <div class="col-sm-10">
                                  <div class="row">
                                    <div class="col-sm-6">
                                      <input type="text" name="{{ code }}[{{ store.store_id }}][manufacturer_product_limits]" value="{{ module_smart_sorting[store.store_id].manufacturer_product_limits }}" id="input-store-{{ store.store_id }}-manufacturer-product-limits" class="form-control" />
                                    </div>
                                  </div>
                                </div>
                              </div>
                              <div class="form-group">
