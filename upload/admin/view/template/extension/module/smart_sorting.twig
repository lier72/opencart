                                  <input type="hidden" name="{{ code }}[{{ store.store_id }}][search_product_limit_status]" value="0" />
                                  <div class="checkbox">
                                    <label>
                                      <input type="checkbox" id="input-store-{{ store.store_id }}-search-product-limit-status" name="{{ code }}[{{ store.store_id }}][search_product_limit_status]" value="1" {{ module_smart_sorting[store.store_id].search_product_limit_status == true ? 'checked' : '' }} />
                                      {{ entry_search_product_limit_status }}
