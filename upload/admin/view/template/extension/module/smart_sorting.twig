                                  </div>
                                </div>
                              </div>
                            </div>                            
                            
                            <div class="{{ module_smart_sorting[store.store_id].search_product_limit_status == true ? 'open' : 'closed' }}" data-bs-switch-toggle-id="toggle-store-{{ store.store_id }}-search-product-limit-status">
                            
                              <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-store-{{ store.store_id }}-search-product-limits">
                                  <span data-toggle="tooltip" title="{{ help_search_product_limits }}">{{ entry_search_product_limits }}</span>
