{{ header }}{{ column_left }}
<div id="content">
  
  <div id="SmartSorting">
  
    <div class="page-header">
      <div class="container-fluid">
        <div class="pull-right">
          <button type="button" data-submission_type="save" data-code="{{ code }}" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary">
            <i class="fa fa-save"></i>
          </button>        
          <button  type="button" data-submission_type="save-and-close" data-code="{{ code }}" data-toggle="tooltip" title="{{ button_save_and_close }}" class="btn btn-info">
            <i class="fa fa-save"></i>
          </button>        
          <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
        </div>
        <h1>{{ heading_title }} <span class="version badge">{{ version }}</span></h1>
        <ul class="breadcrumb">
          {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
          {% endfor %}
        </ul> 
      </div>
    </div>
    <div class="container-fluid">    
      
      {% if error_warning %}
        <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      {% endif %}

      {% if success %}
        <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      {% endif %}

      <div id="fountainG" class="ajax-loader">
        <div id="fountainG_1" class="fountainG"></div>
        <div id="fountainG_2" class="fountainG"></div>
        <div id="fountainG_3" class="fountainG"></div>
        <div id="fountainG_4" class="fountainG"></div>
        <div id="fountainG_5" class="fountainG"></div>
        <div id="fountainG_6" class="fountainG"></div>
        <div id="fountainG_7" class="fountainG"></div>
        <div id="fountainG_8" class="fountainG"></div>
      </div>
      
      <div class="panel panel-default">

        <div class="panel-heading">
          <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
        </div>

        <div class="panel-body">

          <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-{{ code }}" class="form-horizontal" autocomplete="off">

            <ul id="global-tabs" class="nav nav-tabs">
              <li class="active"><a href="#tab-smart-sorting" data-toggle="tab"><i class="fa fa-sort green" aria-hidden="true"></i>{{ tab_smart_sorting }}</a></li>
              <li><a href="#tab-config" data-toggle="tab"><i class="fa fa-cog violet"></i>{{ tab_config }}</a></li>
              <li><a href="#tab-help" data-toggle="tab"><i class="fa fa-life-ring marine-blue" aria-hidden="true"></i>{{ tab_help }} <span class="badge badge-tab-help"></span></a></li>
            </ul>

            <div class="tab-content">

              <div id="tab-smart-sorting" class="tab-pane active">

                <ul id="smart-sorting-tabs" class="nav nav-tabs">
                  <li class="active"><a href="#tab-smart-sorting-category" data-toggle="tab"><i class="fa fa-tags green" aria-hidden="true"></i>{{ tab_smart_sorting_category }}</a></li>
                  <li><a href="#tab-smart-sorting-manufacturer" data-toggle="tab"><i class="fa fa-wrench violet" aria-hidden="true"></i>{{ tab_smart_sorting_manufacturer }}</a></li>
                  <li><a href="#tab-smart-sorting-search" data-toggle="tab"><i class="fa fa-search marine-blue" aria-hidden="true"></i>{{ tab_smart_sorting_search }}</a></li>
                  <li><a href="#tab-smart-sorting-special" data-toggle="tab"><i class="fa fa-cube orange" aria-hidden="true"></i>{{ tab_smart_sorting_special }}</a></li>
                </ul>
                
                <div class="tab-content">
                  
                  <div id="tab-smart-sorting-category" class="tab-pane active">
                    
                    <div class="vtabs">
                      <div class="col-sm-3">
                        <ul id="smart-sorting-category-store-tabs" class="vtabs-tab-container nav nav-tabs tabs-left"><!--<ul class="vtabs-tab-container nav nav-pills nav-stacked">-->
                          {% for store in stores %}
                            <li class="{{ store.store_id == 0 ? "active" : "" }}">
                              <a href="#tab-smart-sorting-category-store-{{ store.store_id }}" data-toggle="tab">
                                <span class="{{ module_smart_sorting[store.store_id].category_status == false ? 'red' : '' }}">{{ store.name }}</span>
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                      <!-- .col -->

                      <hr class="hidden-lg hidden-md hidden-sm" />

                      <div class="vtabs-content-container tab-content col-sm-9">
                        
                        {% for store in stores %}
                        
                          <fieldset id="tab-smart-sorting-category-store-{{ store.store_id }}" class="tab-pane {{ store.store_id == 0 ? "active" : "" }}">

                            <legend>{{ store.name }} - {{ text_heading_category }}</legend>

                            <div class="form-group">
                              <label class="col-sm-2 control-label" for="input-store-{{ store.store_id }}-category-status">
                                <span data-toggle="tooltip" title="{{ help_category_status }}">{{ entry_category_status }}</span>
                              </label>
                              <div class="col-sm-10">
                                <div class="row">
                                  <div class="col-sm-6">
                                    <select name="{{ code }}[{{ store.store_id }}][category_status]" id="input-store-{{ store.store_id }}-category-status" class="form-control">
                                      {% if module_smart_sorting[store.store_id].category_status %}
                                      <option value="1" selected="selected">{{ text_enabled }}</option>
                                      <option value="0">{{ text_disabled }}</option>
                                      {% else %}
                                      <option value="1">{{ text_enabled }}</option>
                                      <option value="0" selected="selected">{{ text_disabled }}</option>
                                      {% endif %}
                                    </select>
                                  </div>
                                </div>
                              </div>
                            </div>

                            <hr />

                            <div class="form-group">
                              <label class="col-sm-2 control-label" for="input-store-{{ store.store_id }}-category-disable-sorting-methods">
                                {{ entry_category_disable_sorting_methods }}</span>
                              </label>
                              <div class="col-sm-10">
                                <div class="well well-sm well-scrollable mbm">
                                  <input type="hidden" name="{{ code }}[{{ store.store_id }}][category_disable_sorting_methods][]" value="" />
                                  {% for category_sorting_method in category_sorting_methods %}
                                  <div class="checkbox">
                                    <label>
                                      <input type="checkbox" name="{{ code }}[{{ store.store_id }}][category_disable_sorting_methods][]" value="{{ category_sorting_method.value }}" {{ (category_sorting_method.value in module_smart_sorting[store.store_id].category_disable_sorting_methods) ? 'checked' : '' }} />
                                      {{ category_sorting_method.text }}
                                    </label>
                                  </div>
                                  {% endfor %}
                                </div>
                                <div class="check-uncheck-all-container">
                                  <a href="#" class="well-check-all btn btn-info btn-sm">{{ text_check_all }}</a>
                                  <a href="#" class="well-uncheck-all btn btn-warning btn-sm">{{ text_uncheck_all }}</a>
                                </div>                      
                              </div>
                            </div>

                            <div class="space-10"></div>

                            <div class="form-group">
                              <label class="col-sm-2 control-label" for="input-store-{{ store.store_id }}-category-default-sort-order">
                                {{ entry_category_default_sort_order }}
                              </label>
                              <div class="col-sm-10">
                                <div class="row">
                                  <div class="col-sm-6">
                                    <select name="{{ code }}[{{ store.store_id }}][category_default_sort_order]" id="input-store-{{ store.store_id }}-category-default-sort-order" class="form-control">
                                      {% for category_sorting_method in category_sorting_methods %}
                                        <option value="{{ category_sorting_method.value }}" {{ category_sorting_method.value == module_smart_sorting[store.store_id].category_default_sort_order ? 'selected="selected"' : '' }}>{{ category_sorting_method.text }}</option>
                                      {% endfor %}
                                    </select>
                                  </div>
                                </div>
                              </div>
                            </div>

                            <hr />
                            
                            <div class="form-group">
                              <label class="col-sm-2 control-label" for="input-store-{{ store.store_id }}-category-product-limit-status"></label>
                              <div class="col-sm-10">
                                <div class="bs-switch bs-switch-common" data-bs-switch-toggle-target="toggle-store-{{ store.store_id }}-category-product-limit-status">
                                  <input type="hidden" name="{{ code }}[{{ store.store_id }}][category_product_limit_status]" value="0" />
                                  <div class="checkbox">
                                    <label>
                                      <input type="checkbox" id="input-store-{{ store.store_id }}-category-product-limit-status" name="{{ code }}[{{ store.store_id }}][category_product_limit_status]" value="1" {{ module_smart_sorting[store.store_id].category_product_limit_status == true ? 'checked' : '' }} />
                                      {{ entry_category_product_limit_status }}
                                    </label>
                                  </div>
                                </div>
                              </div>
                            </div>                            
                            
                            <div class="{{ module_smart_sorting[store.store_id].category_product_limit_status == true ? 'open' : 'closed' }}" data-bs-switch-toggle-id="toggle-store-{{ store.store_id }}-category-product-limit-status">
                            
                              <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-store-{{ store.store_id }}-category-product-limits">
                                  <span data-toggle="tooltip" title="{{ help_category_product_limits }}">{{ entry_category_product_limits }}</span>
                                </label>
                                <div class="col-sm-10">
                                  <div class="row">
                                    <div class="col-sm-6">
                                      <input type="text" name="{{ code }}[{{ store.store_id }}][category_product_limits]" value="{{ module_smart_sorting[store.store_id].category_product_limits }}" id="input-store-{{ store.store_id }}-category-product-limits" class="form-control" />
                                    </div>
                                  </div>
                                </div>
                              </div>
                              <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-store-{{ store.store_id }}-category-default-product-limit">
                                  <span data-toggle="tooltip" title="{{ help_category_default_product_limit }}">{{ entry_category_default_product_limit }}</span>
                                </label>
                                <div class="col-sm-10">
                                  <div class="row">
                                    <div class="col-sm-3 col-md-2">
                                      <input type="number" name="{{ code }}[{{ store.store_id }}][category_default_product_limit]" value="{{ module_smart_sorting[store.store_id].category_default_product_limit }}" id="input-store-{{ store.store_id }}-category-default-product-limit" class="form-control" min="1" />
                                    </div>
                                  </div>
                                </div>
                              </div>                   
                            </div>
 
                          </fieldset>
                        
                        {% endfor %}

                      </div>
                      <!-- /.vtabs-content-container -->
                    </div>
                    <!-- /.vtabs -->

                  </div>
                  <!-- /.tab-pane -->
                  
                  <div id="tab-smart-sorting-manufacturer" class="tab-pane">

                    <div class="vtabs">
                      <div class="col-sm-3">
                        <ul id="smart-sorting-manufacturer-store-tabs" class="vtabs-tab-container nav nav-tabs tabs-left"><!--<ul class="vtabs-tab-container nav nav-pills nav-stacked">-->
