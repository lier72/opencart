                                    <select name="{{ code }}[{{ store.store_id }}][search_default_sort_order]" id="input-store-{{ store.store_id }}-search-default-sort-order" class="form-control">
                                      {% for search_sorting_method in search_sorting_methods %}
                                        <option value="{{ search_sorting_method.value }}" {{ search_sorting_method.value == module_smart_sorting[store.store_id].search_default_sort_order ? 'selected="selected"' : '' }}>{{ search_sorting_method.text }}</option>
