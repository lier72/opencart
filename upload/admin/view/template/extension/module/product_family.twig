{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-product-family" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-product-family" class="form-horizontal">

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_product_family_status" id="input-status" class="form-control">
                {% if module_product_family_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-model-attribute"><span data-toggle="tooltip" title="{{ help_model_attribute }}">{{ entry_model_attribute }}</span></label>
            <div class="col-sm-10">
              <select name="module_product_family_model_attribute_id" id="input-model-attribute" class="form-control">
                <option value="">-- Выберите атрибут --</option>
                {% for attribute in attributes %}
                <option value="{{ attribute.attribute_id }}"{% if module_product_family_model_attribute_id == attribute.attribute_id %} selected="selected"{% endif %}>{{ attribute.name }} (Группа: {{ attribute.attribute_group }})</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_variant_attributes }}">{{ entry_variant_attributes }}</span></label>
            <div class="col-sm-10">
              <div class="well well-sm" style="height: 150px; overflow: auto;">
                {% for attribute in attributes %}
                <div class="checkbox">
                  <label>
                    <input type="checkbox" name="module_product_family_variant_attributes[]" value="{{ attribute.attribute_id }}"{% if attribute.attribute_id in module_product_family_variant_attributes %} checked="checked"{% endif %} />
                    {{ attribute.name }} ({{ attribute.attribute_group }})
                  </label>
                </div>
                {% endfor %}
              </div>
            </div>
          </div>

          <hr>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-strict-mode"><span data-toggle="tooltip" title="{{ help_strict_mode }}">{{ entry_strict_mode }}</span></label>
            <div class="col-sm-10">
              <select name="module_product_family_strict_mode" id="input-strict-mode" class="form-control">
                {% if module_product_family_strict_mode %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_strict_categories }}">{{ entry_strict_categories }}</span></label>
            <div class="col-sm-10">
              <div class="well well-sm" style="height: 150px; overflow: auto;">
                {% for category in categories %}
                <div class="checkbox">
                  <label>
                    <input type="checkbox" name="module_product_family_strict_categories[]" value="{{ category.category_id }}"{% if category.category_id in module_product_family_strict_categories %} checked="checked"{% endif %} />
                    {{ category.name }}
                  </label>
                </div>
                {% endfor %}
              </div>
              <div class="help-block">Для выбранных категорий будет использоваться группировка по полю model (AWSU076-1, AWSU076-2 → база AWSU076)</div>
            </div>
          </div>

          <hr>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-show-image">{{ entry_show_image }}</label>
            <div class="col-sm-10">
              <select name="module_product_family_show_image" id="input-show-image" class="form-control">
                {% if module_product_family_show_image %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_show_image_categories }}">{{ entry_show_image_categories }}</span></label>
            <div class="col-sm-10">
              <div class="well well-sm" style="height: 150px; overflow: auto;">
                {% for category in categories %}
                <div class="checkbox">
                  <label>
                    <input type="checkbox" name="module_product_family_show_image_categories[]" value="{{ category.category_id }}"{% if category.category_id in module_product_family_show_image_categories %} checked="checked"{% endif %} />
                    {{ category.name }}
                  </label>
                </div>
                {% endfor %}
              </div>
              <div class="help-block">Если не выбрано ни одной категории, используется глобальная настройка выше</div>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-show-price">{{ entry_show_price }}</label>
            <div class="col-sm-10">
              <select name="module_product_family_show_price" id="input-show-price" class="form-control">
                {% if module_product_family_show_price %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-image-width">{{ entry_image_width }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_product_family_image_width" value="{{ module_product_family_image_width }}" placeholder="{{ entry_image_width }}" id="input-image-width" class="form-control" />
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-image-height">{{ entry_image_height }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_product_family_image_height" value="{{ module_product_family_image_height }}" placeholder="{{ entry_image_height }}" id="input-image-height" class="form-control" />
            </div>
          </div>

          <hr>

          <div class="form-group">
            <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_attribute_config }}">{{ entry_attribute_config }}</span></label>
            <div class="col-sm-10">
              <div class="table-responsive">
                <table id="attribute-config-table" class="table table-striped table-bordered table-hover">
                  <thead>
                    <tr>
                      <td class="text-left">Атрибут</td>
                      <td class="text-left">Метка (необязательно)</td>
                      <td class="text-left">Regex Pattern (необязательно)</td>
                      <td class="text-center">Всегда показывать</td>
                      <td></td>
                    </tr>
                  </thead>
                  <tbody>
                    {% set config_row = 0 %}
                    {% if module_product_family_attribute_config %}
                      {% for config in module_product_family_attribute_config %}
                        <tr id="config-row{{ config_row }}">
                          <td class="text-left">
                            <select name="module_product_family_attribute_config[{{ config_row }}][attribute_id]" class="form-control">
                              <option value="">-- Выберите атрибут --</option>
                              {% for attribute in attributes %}
                                <option value="{{ attribute.attribute_id }}"{% if config.attribute_id == attribute.attribute_id %} selected="selected"{% endif %}>{{ attribute.name }} ({{ attribute.attribute_group }})</option>
                              {% endfor %}
                            </select>
                          </td>
                          <td class="text-left">
                            <input type="text" name="module_product_family_attribute_config[{{ config_row }}][label]" value="{{ config.label }}" placeholder="Пользовательская метка" class="form-control" />
                          </td>
                          <td class="text-left">
                            <input type="text" name="module_product_family_attribute_config[{{ config_row }}][regex]" value="{{ config.regex }}" placeholder="\((G\d+)\)" class="form-control" />
                          </td>
                          <td class="text-center">
                            <input type="checkbox" name="module_product_family_attribute_config[{{ config_row }}][always_show]" value="1"{% if config.always_show %} checked="checked"{% endif %} />
                          </td>
                          <td class="text-left">
                            <button type="button" onclick="$('#config-row{{ config_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
                          </td>
                        </tr>
                        {% set config_row = config_row + 1 %}
                      {% endfor %}
                    {% endif %}
                  </tbody>
                  <tfoot>
                    <tr>
                      <td colspan="4"></td>
                      <td class="text-left">
                        <button type="button" onclick="addAttributeConfig();" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button>
                      </td>
                    </tr>
                  </tfoot>
                </table>
              </div>
              <div class="help-block">
                <strong>Пример:</strong> Для атрибута со значением "Размер ручки: 79.3мм (G6)":<br>
                - Метка: "Рукоятка"<br>
                - Regex: <code>\((G\d+)\)</code> (извлечёт "G6")<br><br>
                Regex использует первую захваченную группу (в скобках), либо полное совпадение, если групп нет.
              </div>
            </div>
          </div>

        </form>

        <script type="text/javascript">
        var config_row = {{ config_row }};

        function addAttributeConfig() {
          html  = '<tr id="config-row' + config_row + '">';
          html += '  <td class="text-left">';
          html += '    <select name="module_product_family_attribute_config[' + config_row + '][attribute_id]" class="form-control">';
          html += '      <option value="">-- Выберите атрибут --</option>';
          {% for attribute in attributes %}
          html += '      <option value="{{ attribute.attribute_id }}">{{ attribute.name|escape('js') }} ({{ attribute.attribute_group|escape('js') }})</option>';
          {% endfor %}
          html += '    </select>';
          html += '  </td>';
          html += '  <td class="text-left">';
          html += '    <input type="text" name="module_product_family_attribute_config[' + config_row + '][label]" value="" placeholder="Пользовательская метка" class="form-control" />';
          html += '  </td>';
          html += '  <td class="text-left">';
          html += '    <input type="text" name="module_product_family_attribute_config[' + config_row + '][regex]" value="" placeholder="\\((G\\d+)\\)" class="form-control" />';
          html += '  </td>';
          html += '  <td class="text-center">';
          html += '    <input type="checkbox" name="module_product_family_attribute_config[' + config_row + '][always_show]" value="1" />';
          html += '  </td>';
          html += '  <td class="text-left">';
          html += '    <button type="button" onclick="$(\'#config-row' + config_row + '\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>';
          html += '  </td>';
          html += '</tr>';

          $('#attribute-config-table tbody').append(html);

          config_row++;
        }
        </script>
      </div>
    </div>
  </div>
</div>
{{ footer }}
