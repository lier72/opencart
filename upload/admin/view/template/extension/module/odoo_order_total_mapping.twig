{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
            </div>
            <div class="panel-body">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i> {{ text_order_total_mapping_help }}
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="order-total-mapping-table">
                        <thead>
                            <tr>
                                <th>{{ column_total_code }}</th>
                                <th>{{ column_include_pattern }}</th>
                                <th>{{ column_exclude_pattern }}</th>
                                <th>{{ column_odoo_product_id }}</th>
                                <th>{{ column_odoo_product_name }}</th>
                                <th>{{ column_priority }}</th>
                                <th>{{ column_active }}</th>
                                <th>{{ column_action }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if mappings %}
                                {% for mapping in mappings %}
                                <tr data-id="{{ mapping.id }}">
                                    <td><input type="text" class="form-control input-sm total-code" value="{{ mapping.opencart_total_code }}" /></td>
                                    <td><input type="text" class="form-control input-sm include-pattern" value="{{ mapping.title_include_pattern }}" /></td>
                                    <td><input type="text" class="form-control input-sm exclude-pattern" value="{{ mapping.title_exclude_pattern }}" /></td>
                                    <td><input type="number" class="form-control input-sm odoo-product-id" value="{{ mapping.odoo_product_id }}" min="0" /></td>
                                    <td><input type="text" class="form-control input-sm odoo-product-name" value="{{ mapping.odoo_product_name }}" /></td>
                                    <td><input type="number" class="form-control input-sm priority" value="{{ mapping.priority }}" /></td>
                                    <td class="text-center"><input type="checkbox" class="active-checkbox" {% if mapping.is_active == 1 %}checked{% endif %} /></td>
                                    <td class="text-nowrap">
                                        <button type="button" class="btn btn-primary btn-sm save-mapping"><i class="fa fa-save"></i> {{ button_save }}</button>
                                        <button type="button" class="btn btn-danger btn-sm delete-mapping"><i class="fa fa-trash"></i> {{ button_delete }}</button>
                                    </td>
                                </tr>
                                {% endfor %}
                            {% else %}
                                <tr class="no-results-row">
                                    <td colspan="8" class="text-center">{{ text_no_results }}</td>
                                </tr>
                            {% endif %}
                            <tr id="new-mapping-row">
                                <td><input type="text" class="form-control input-sm total-code" value="" placeholder="reward" /></td>
                                <td><input type="text" class="form-control input-sm include-pattern" value="" placeholder="" /></td>
                                <td><input type="text" class="form-control input-sm exclude-pattern" value="" placeholder="Самовывоз из магазина" /></td>
                                <td><input type="number" class="form-control input-sm odoo-product-id" value="0" min="0" /></td>
                                <td><input type="text" class="form-control input-sm odoo-product-name" value="" /></td>
                                <td><input type="number" class="form-control input-sm priority" value="100" /></td>
                                <td class="text-center"><input type="checkbox" class="active-checkbox" checked="checked" /></td>
                                <td><button type="button" class="btn btn-success btn-sm" id="create-mapping"><i class="fa fa-plus"></i> {{ button_add_mapping }}</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript"><!--
function collectMappingData(row) {
    return {
        id: row.data('id'),
        opencart_total_code: row.find('.total-code').val(),
        title_include_pattern: row.find('.include-pattern').val(),
        title_exclude_pattern: row.find('.exclude-pattern').val(),
        odoo_product_id: row.find('.odoo-product-id').val(),
        odoo_product_name: row.find('.odoo-product-name').val(),
        priority: row.find('.priority').val(),
        is_active: row.find('.active-checkbox').is(':checked') ? 1 : 0
    };
}

function flashRow(row, color) {
    row.css('background-color', color);
    setTimeout(function() {
        row.css('background-color', '');
    }, 1500);
}

function showAjaxError(xhr, error) {
    var responseText = xhr && xhr.responseText ? $.trim(xhr.responseText) : '';

    if (responseText) {
        alert(responseText);
    } else {
        alert(error);
    }
}

$('.save-mapping').on('click', function() {
    var btn = $(this);
    var row = btn.closest('tr');

        $.ajax({
        url: 'index.php?route=extension/module/odoo_connector/updateOrderTotalMapping&user_token={{ user_token }}',
        type: 'POST',
        data: collectMappingData(row),
        dataType: 'json',
        beforeSend: function() {
            btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i>');
        },
        complete: function() {
            btn.prop('disabled', false).html('<i class="fa fa-save"></i> {{ button_save }}');
        },
        success: function(json) {
            if (json.success) {
                flashRow(row, '#d4edda');
            } else if (json.error) {
                alert(json.error);
            }
        },
        error: function(xhr, status, error) {
            showAjaxError(xhr, error);
        }
    });
});

$('.delete-mapping').on('click', function() {
    var btn = $(this);
    var row = btn.closest('tr');

    if (!confirm('{{ text_confirm }}')) {
        return;
    }

    $.ajax({
        url: 'index.php?route=extension/module/odoo_connector/deleteOrderTotalMapping&user_token={{ user_token }}',
        type: 'POST',
        data: {id: row.data('id')},
        dataType: 'json',
        beforeSend: function() {
            btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i>');
        },
        complete: function() {
            btn.prop('disabled', false).html('<i class="fa fa-trash"></i> {{ button_delete }}');
        },
        success: function(json) {
            if (json.success) {
                row.remove();
            } else if (json.error) {
                alert(json.error);
            }
        },
        error: function(xhr, status, error) {
            showAjaxError(xhr, error);
        }
    });
});

$('#create-mapping').on('click', function() {
    var btn = $(this);
    var row = $('#new-mapping-row');

    $.ajax({
        url: 'index.php?route=extension/module/odoo_connector/createOrderTotalMapping&user_token={{ user_token }}',
        type: 'POST',
        data: collectMappingData(row),
        dataType: 'json',
        beforeSend: function() {
            btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i>');
        },
        complete: function() {
            btn.prop('disabled', false).html('<i class="fa fa-plus"></i> {{ button_add_mapping }}');
        },
        success: function(json) {
            if (json.success) {
                location.reload();
            } else if (json.error) {
                alert(json.error);
            }
        },
        error: function(xhr, status, error) {
            showAjaxError(xhr, error);
        }
    });
});
//--></script>
{{ footer }}
