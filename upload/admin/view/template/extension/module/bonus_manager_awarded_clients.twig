{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" data-toggle="tooltip" title="{{ button_filter }}" onclick="$('#filter-awarded').toggleClass('hidden-sm hidden-xs');" class="btn btn-default hidden-md hidden-lg"><i class="fa fa-filter"></i></button>
        <a href="{{ dashboard_link }}" class="btn btn-default"><i class="fa fa-reply"></i> {{ text_dashboard }}</a>
      </div>
      <h1>{{ heading_title }} - {{ text_awarded_clients }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    <div class="row">
      <div id="filter-awarded" class="col-md-3 col-md-push-9 col-sm-12 hidden-sm hidden-xs">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3>
          </div>
          <div class="panel-body">
            <div class="form-group">
              <label class="control-label" for="input-customer">{{ entry_customer }}</label>
              <input type="text" name="filter_customer" value="{{ filter_customer }}" placeholder="{{ entry_customer }}" id="input-customer" class="form-control" />
            </div>
            <div class="form-group">
              <label class="control-label" for="input-date-from">{{ entry_date_from }}</label>
              <div class="input-group date">
                <input type="text" name="filter_date_from" value="{{ filter_date_from }}" placeholder="{{ entry_date_from }}" data-date-format="YYYY-MM-DD" id="input-date-from" class="form-control" />
                <span class="input-group-btn">
                <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
                </span>
              </div>
            </div>
            <div class="form-group">
              <label class="control-label" for="input-date-to">{{ entry_date_to }}</label>
              <div class="input-group date">
                <input type="text" name="filter_date_to" value="{{ filter_date_to }}" placeholder="{{ entry_date_to }}" data-date-format="YYYY-MM-DD" id="input-date-to" class="form-control" />
                <span class="input-group-btn">
                <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
                </span>
              </div>
            </div>
            <div class="form-group">
              <label class="control-label" for="input-min-remaining">{{ entry_min_remaining }}</label>
              <input type="number" name="filter_min_remaining" value="{{ filter_min_remaining }}" id="input-min-remaining" class="form-control" min="0" />
            </div>
            <div class="form-group text-right">
              <button type="button" id="button-filter" class="btn btn-default"><i class="fa fa-filter"></i> {{ button_filter }}</button>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-9 col-md-pull-3 col-sm-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_awarded_clients }}</h3>
          </div>
          <div class="panel-body">
            <p class="text-muted">{{ text_awarded_clients_help }}</p>
            <div class="table-responsive">
              <table class="table table-bordered table-hover">
                <thead>
                  <tr>
                    <td class="text-left">{{ column_customer }}</td>
                    <td class="text-left">{{ column_loyalty_level }}</td>
                    <td class="text-right">{{ column_total_awarded }}</td>
                    <td class="text-right">{{ column_total_remaining }}</td>
                    <td class="text-left">{{ column_last_award_date }}</td>
                  </tr>
                </thead>
                <tbody>
                  {% if clients|length > 0 %}
                    {% for client in clients %}
                      {% set row_link = '' %}
                      {% if client.customer_id %}
                        {% set row_link = 'index.php?route=customer/customer/edit&user_token=' ~ user_token ~ '&customer_id=' ~ client.customer_id %}
                      {% endif %}
                      <tr{% if row_link %} class="js-row-link" data-href="{{ row_link }}"{% endif %}>
                        <td class="text-left">{{ client.customer_name }}<br/><small>{{ client.email }}</small></td>
                        <td class="text-left">{{ client.loyalty_level }}</td>
                        <td class="text-right">{{ client.total_awarded }}</td>
                        <td class="text-right">{{ client.total_remaining }}</td>
                        <td class="text-left">{{ client.last_award_date }}</td>
                      </tr>
                    {% endfor %}
                  {% else %}
                    <tr>
                      <td class="text-center" colspan="5">No clients.</td>
                    </tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
            <div class="text-right">{{ pagination }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}

<script type="text/javascript">
(function() {
  document.getElementById('button-filter').addEventListener('click', function() {
    var url = 'index.php?route=extension/module/bonus_manager/awardedClients&user_token={{ user_token }}';
    var customer = document.getElementById('input-customer').value;
    var dateFrom = document.getElementById('input-date-from').value;
    var dateTo = document.getElementById('input-date-to').value;
    var minRemaining = document.getElementById('input-min-remaining').value;

    if (customer) {
      url += '&filter_customer=' + encodeURIComponent(customer);
    }
    if (dateFrom) {
      url += '&filter_date_from=' + encodeURIComponent(dateFrom);
    }
    if (dateTo) {
      url += '&filter_date_to=' + encodeURIComponent(dateTo);
    }
    if (minRemaining) {
      url += '&filter_min_remaining=' + encodeURIComponent(minRemaining);
    }

    window.location.href = url;
  });

  var rows = document.querySelectorAll('.js-row-link');
  for (var i = 0; i < rows.length; i++) {
    rows[i].addEventListener('click', function(e) {
      if (e.target && e.target.tagName && e.target.tagName.toLowerCase() === 'a') {
        return;
      }
      var href = this.getAttribute('data-href');
      if (href) {
        window.location.href = href;
      }
    });
  }
})();
</script>
<script src="view/javascript/jquery/datetimepicker/bootstrap-datetimepicker.min.js" type="text/javascript"></script>
<link href="view/javascript/jquery/datetimepicker/bootstrap-datetimepicker.min.css" type="text/css" rel="stylesheet" media="screen" />
<script type="text/javascript"><!--
$('.date').datetimepicker({
  language: '{{ datepicker }}',
  pickTime: false
});
//--></script>
