{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="button" id="button-sync" data-toggle="tooltip" title="{{ button_sync }}" class="btn btn-success"><i class="fa fa-cloud-download"></i></button>
                <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
                <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-mapping').submit() : false;"><i class="fa fa-trash-o"></i></button>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if error_warning %}
        <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        {% if success %}
        <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-mapping">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead>
                            <tr>
                                <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                                <td class="text-left">{{ column_odoo_pricelist }}</td>
                                <td class="text-left">{{ column_customer_group }}</td>
                                <td class="text-center">{{ column_status }}</td>
                                <td class="text-right">{{ column_last_sync }}</td>
                                <td class="text-right">{{ column_action }}</td>
                            </tr>
                            </thead>
                            <tbody>
                            {% if mappings %}
                            {% for mapping in mappings %}
                            <tr>
                                <td class="text-center">
                                    <input type="checkbox" name="selected[]" value="{{ mapping.id }}" />
                                </td>
                                <td class="text-left">
                                    {{ mapping.odoo_pricelist_name }}
                                    <br/><small>(ID: {{ mapping.odoo_pricelist_id }})</small>
                                </td>
                                <td class="text-left">{{ mapping.customer_group_name }}</td>
                                <td class="text-center">
                                    {% if mapping.is_active %}
                                    <span class="label label-success">{{ text_active }}</span>
                                    {% else %}
                                    <span class="label label-danger">{{ text_inactive }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-right">
                                    {% if mapping.modified_on %}
                                    {{ mapping.modified_on }}
                                    {% else %}
                                    {{ text_never }}
                                    {% endif %}
                                </td>
                                <td class="text-right">
                                    <a href="{{ mapping.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary btn-sm"><i class="fa fa-pencil"></i></a>
                                    <a href="{{ mapping.history }}" data-toggle="tooltip" title="{{ button_history }}" class="btn btn-info btn-sm"><i class="fa fa-clock-o"></i></a>
                                </td>
                            </tr>
                            {% endfor %}
                            {% else %}
                            <tr>
                                <td class="text-center" colspan="6">{{ text_no_results }}</td>
                            </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    </div>
                </form>
            </div>
        </div>
        {% if odoo_pricelists %}
        <div class="panel panel-info">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-info-circle"></i> {{ text_available_pricelists }}</h3>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                        <tr>
                            <td class="text-left">{{ column_pricelist_id }}</td>
                            <td class="text-left">{{ column_pricelist_name }}</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for pricelist in odoo_pricelists %}
                        <tr>
                            <td class="text-left">{{ pricelist.pricelist_id }}</td>
                            <td class="text-left">{{ pricelist.pricelist_name }}</td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>
<script type="text/javascript">
    $('#button-sync').on('click', function() {
        var $button = $(this);

        $.ajax({
            url: '{{ sync_url }}',
            dataType: 'json',
            beforeSend: function() {
                $button.prop('disabled', true);
                $('#content').fadeTo('slow', 0.5);
                $('.alert').remove();
            },
            complete: function() {
                $button.prop('disabled', false);
                $('#content').fadeTo('slow', 1);
            },
            success: function(json) {
                try {
                    if (json.success) {
                        var alertHtml = '<div class="alert alert-success"><i class="fa fa-check-circle"></i> ' +
                            json.message.replace(/\n/g, '<br/>') + '</div>';
                        $('.page-header').after(alertHtml);
                        setTimeout(function() {
                            location.reload();
                        }, 3000);
                    }

                    if (json.error) {
                        var alertHtml = '<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' +
                            json.error + '</div>';
                        $('.page-header').after(alertHtml);
                    }
                } catch(e) {
                    alert('Error processing response: ' + e.message);
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                var message = thrownError;
                if (xhr.responseText) {
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response.error) {
                            message = response.error;
                        }
                    } catch(e) {
                        message = xhr.responseText.substring(0, 100);
                    }
                }
                alert('Error occurred: ' + message);
            }
        });
    });
</script>
{{ footer }}
