{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" data-toggle="tooltip" title="{{ button_filter }}" onclick="$('#filter-loyalty-reviews').toggleClass('hidden-sm hidden-xs');" class="btn btn-default hidden-md hidden-lg"><i class="fa fa-filter"></i></button>
        <a href="{{ dashboard_link }}" class="btn btn-default"><i class="fa fa-reply"></i> {{ text_dashboard }}</a>
      </div>
      <h1>{{ heading_title }} - {{ text_pending_loyalty_downgrades }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>
    {% endif %}

    <div class="row">
      <div id="filter-loyalty-reviews" class="col-md-3 col-md-push-9 col-sm-12 hidden-sm hidden-xs">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3>
          </div>
          <div class="panel-body">
            <div class="form-group">
              <label class="control-label" for="input-customer">{{ entry_customer }}</label>
              <input type="text" name="filter_customer" value="{{ filter_customer }}" placeholder="{{ entry_customer }}" id="input-customer" class="form-control" />
            </div>
            <div class="form-group text-right">
              <button type="button" id="button-filter" class="btn btn-default"><i class="fa fa-filter"></i> {{ button_filter }}</button>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-9 col-md-pull-3 col-sm-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-level-down"></i> {{ text_pending_loyalty_downgrades }}</h3>
          </div>
          <div class="panel-body">
            <p class="text-muted">{{ text_pending_loyalty_downgrades_help }}</p>
            <div class="table-responsive">
              <table class="table table-bordered table-hover">
                <thead>
                  <tr>
                    <td class="text-left">{{ column_customer }}</td>
                    <td class="text-left">{{ column_current_loyalty_level }}</td>
                    <td class="text-left">{{ column_recommended_loyalty_level }}</td>
                    <td class="text-right">{{ column_total_spent }}</td>
                    <td class="text-right">{{ column_required_total_spent }}</td>
                    <td class="text-left">{{ column_period }}</td>
                    <td class="text-right">{{ column_action }}</td>
                  </tr>
                </thead>
                <tbody>
                  {% if reviews|length > 0 %}
                    {% for review in reviews %}
                      <tr>
                        <td class="text-left">
                          <a href="index.php?route=customer/customer/edit&user_token={{ user_token }}&customer_id={{ review.customer_id }}">{{ review.customer_name }}</a>
                          <br />
                          <small>{{ review.email }}</small>
                        </td>
                        <td class="text-left">{{ review.current_loyalty_level }}</td>
                        <td class="text-left">{{ review.recommended_loyalty_level }}</td>
                        <td class="text-right">{{ review.total_spent|number_format(2, '.', ' ') }}</td>
                        <td class="text-right">{{ review.required_total_spent|number_format(2, '.', ' ') }}</td>
                        <td class="text-left">{{ review.period_start }} - {{ review.period_end }}</td>
                        <td class="text-right" style="white-space: nowrap;">
                          <form action="{{ apply_downgrade_action }}" method="post" style="display: inline-block;">
                            <input type="hidden" name="loyalty_review_id" value="{{ review.loyalty_review_id }}" />
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('{{ text_confirm_apply_downgrade|e('js') }}');">
                              <i class="fa fa-level-down"></i> {{ button_apply_downgrade }}
                            </button>
                          </form>
                          <form action="{{ dismiss_downgrade_action }}" method="post" style="display: inline-block; margin-left: 4px;">
                            <input type="hidden" name="loyalty_review_id" value="{{ review.loyalty_review_id }}" />
                            <button type="submit" class="btn btn-default btn-sm" onclick="return confirm('{{ text_confirm_dismiss_downgrade|e('js') }}');">
                              <i class="fa fa-times"></i> {{ button_dismiss_downgrade }}
                            </button>
                          </form>
                        </td>
                      </tr>
                    {% endfor %}
                  {% else %}
                    <tr>
                      <td class="text-center" colspan="7">{{ text_no_pending_loyalty_downgrades }}</td>
                    </tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
            <div class="text-right">{{ pagination }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}

<script type="text/javascript">
(function() {
  document.getElementById('button-filter').addEventListener('click', function() {
    var url = 'index.php?route=extension/module/bonus_manager/loyaltyReviews&user_token={{ user_token }}';
    var customer = document.getElementById('input-customer').value;

    if (customer) {
      url += '&filter_customer=' + encodeURIComponent(customer);
    }

    window.location.href = url;
  });
})();
</script>
