{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if warning %}
    <div class="alert alert-warning alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <main class="gcrdev-sitemap">
      <div class="tab-content">
        <input id="tab1" type="radio" name="tabs" checked>
        <label for="tab1">Sitemap</label>
        <input id="tab2" type="radio" name="tabs">
        <label for="tab2">Robots</label>
        <input id="tab3" type="radio" name="tabs">
        <label for="tab3">Settings</label>
        <input id="tab4" type="radio" name="tabs">
        <label for="tab4">Help</label>

        <!-- Sitemap Tab -->
        <section id="content1">
          <form action="{{ action }}" method="post">
            <div class="container-fluid">
              <div class="panel panel-default">
                <div class="panel-heading">
                  <h3 class="panel-title"><i class="fa fa-sitemap"></i> {{ text_sitemap_header }}</h3>
                </div>
                <div class="panel-body">
                  <table class="table table-hover">
                    <thead>
                      <tr>
                        <td class="text-left">{{ text_group }}</td>
                        <td class="text-left">{{ text_generate }}</td>
                        <td class="text-left">Restore</td>
                        <td class="text-left">Last updated</td>
                      </tr>
                    </thead>
                    <tbody>
                      {% for sitemap in sitemaps %}
                      <input type="hidden" name="id[]" value="{{ sitemap.id }}">
                      <tr>
                        <td class="text-left">{{ sitemap.groups }}</td>
                        <td class="text-left">
                          <button type="submit" name="generate_{{ sitemap.groups }}" data-toggle="tooltip" title="{{ text_generate }}{{ sitemap.groups }}{{ text_sitemap_gen }}" class="btn invisi-btn-gcrdev">{{ button_generate_sitemap|raw }}</button>
                        </td>
                        <td class="text-left">
                          <button type="submit" name="restore_{{ sitemap.groups }}" data-toggle="tooltip" title="{{ button_restore_title }}" class="btn invisi-btn-gcrdev">{{ button_restore|raw }}</button>
                        </td>
                        <td class="text-left">
                          {% if sitemap.last_update == '01 Jan 1970' %}
                          never
                          {% else %}
                          {{ sitemap.last_update }}<br>{{ sitemap.last_update_time }}
                          {% endif %}
                        </td>
                      </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                  <table class="table table-hover">
                    <thead>
                      <tr>
                        <td class="text-left">Submit sitemap</td>
                      </tr>
                    </thead>
                    <tbody>
                      {{ store_url|raw }}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </form>
        </section>

        <!-- Robots Tab -->
        <section id="content2">
          <form action="{{ action }}" method="post">
            <div class="container-fluid">
              <div class="panel panel-default">
                <div class="panel-heading">
                  <h3 class="panel-title"><i class="fa fa-bug"></i> {{ text_robots_header }}</h3>
                </div>
                <div class="panel-body">
                  <div class="panel-heading">
                    <h3 class="panel-title">{{ text_robots }}</h3>
                  </div>
                  <textarea name="robots" placeholder="Enter sitemap information here" style="width:100%;height:100px;">{{ robots_content }}</textarea>
                  <div class="pull-right">
                    <button type="submit" name="generate_robots" data-toggle="tooltip" title="{{ button_generate_robots_title }}" class="btn invisi-btn-gcrdev">{{ button_generate_robots|raw }}</button>
                  </div>
                </div>
              </div>
            </div>
          </form>
        </section>

        <!-- Settings Tab -->
        <section id="content3">
          <form action="{{ action }}" method="post">
            <div class="container-fluid">
              <div class="panel panel-default">
                <div class="panel-heading">
                  <h3 class="panel-title"><i class="fa fa-cogs"></i> {{ text_settings_header }}</h3>
                </div>
                <div class="panel-body">
                  <table class="table table-hover">
                    <thead>
                      <tr>
                        <td>Include disabled?</td>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td class="text-center" style="width:33%">
                          Products
                          <div class="switch">
                            <label>
                              <input type="checkbox" name="disprod" class="ios-switch green"{{ prodCheck|raw }} /><div><div></div></div>
                            </label>
                          </div>
                        </td>
                        <td class="text-center" style="width:33%">
                          Categories
                          <div class="switch">
                            <label>
                              <input type="checkbox" name="discat" class="ios-switch green"{{ catCheck|raw }} /><div><div></div></div>
                            </label>
                          </div>
                        </td>
                        <td class="text-center" style="width:33%">
                          Information
                          <div class="switch">
                            <label>
                              <input type="checkbox" name="disinfo" class="ios-switch green"{{ infoCheck|raw }} /><div><div></div></div>
                            </label>
                          </div>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                  <table class="table table-bordered table-hover">
                    <thead>
                      <tr>
                        <td class="text-left">{{ text_group }}</td>
                        <td class="text-left">{{ text_change }}</td>
                        <td class="text-left">{{ text_priority }}</td>
                        <td class="text-left">{{ text_limit }}</td>
                        <td class="text-left" style="width:50px;">{{ text_style }}</td>
                      </tr>
                    </thead>
                    <tbody>
                      {% set i = 0 %}
                      {% for sitemap in sitemaps %}
                      <input type="hidden" name="id[]" value="{{ sitemap.id }}">
                      <tr>
                        <td class="text-left">{{ sitemap.groups }}</td>
                        <td class="text-center">
                          <select name="prod_change_freq[]" class="form-control">
                            <option disabled>Change frequency</option>
                            <option value="never"{% if sitemap.change == 'never' %} selected{% endif %}>never</option>
                            <option value="always"{% if sitemap.change == 'always' %} selected{% endif %}>always</option>
                            <option value="hourly"{% if sitemap.change == 'hourly' %} selected{% endif %}>hourly</option>
                            <option value="daily"{% if sitemap.change == 'daily' %} selected{% endif %}>daily</option>
                            <option value="weekly"{% if sitemap.change == 'weekly' %} selected{% endif %}>weekly</option>
                            <option value="monthly"{% if sitemap.change == 'monthly' %} selected{% endif %}>monthly</option>
                            <option value="yearly"{% if sitemap.change == 'yearly' %} selected{% endif %}>yearly</option>
                          </select>
                        </td>
                        <td class="text-center">
                          <select name="prod_priority[]" class="form-control">
                            <option disabled>Priority</option>
                            <option value="1.0"{% if sitemap.priority == '1.0' %} selected{% endif %}>1.0</option>
                            <option value="0.9"{% if sitemap.priority == '0.9' %} selected{% endif %}>0.9</option>
                            <option value="0.8"{% if sitemap.priority == '0.8' %} selected{% endif %}>0.8</option>
                            <option value="0.7"{% if sitemap.priority == '0.7' %} selected{% endif %}>0.7</option>
                            <option value="0.6"{% if sitemap.priority == '0.6' %} selected{% endif %}>0.6</option>
                            <option value="0.5"{% if sitemap.priority == '0.5' %} selected{% endif %}>0.5</option>
                            <option value="0.4"{% if sitemap.priority == '0.4' %} selected{% endif %}>0.4</option>
                            <option value="0.3"{% if sitemap.priority == '0.3' %} selected{% endif %}>0.3</option>
                            <option value="0.2"{% if sitemap.priority == '0.2' %} selected{% endif %}>0.2</option>
                            <option value="0.1"{% if sitemap.priority == '0.1' %} selected{% endif %}>0.1</option>
                            <option value="0.0"{% if sitemap.priority == '0.0' %} selected{% endif %}>0.0</option>
                          </select>
                        </td>
                        <td class="text-center">
                          <input type="number" class="table-input" name="indlim[]" value="{{ sitemap.indlim }}" min="1" max="10000">
                        </td>
                        <td class="text-center">
                          <input type="checkbox" name="prod_style[{{ i }}]" value="1"{% if sitemap.style == 1 %} checked{% endif %}>
                        </td>
                      </tr>
                      {% set i = i + 1 %}
                      {% endfor %}
                    </tbody>
                  </table>
                  <div class="pull-right">
                    <button type="submit" name="save_settings" data-toggle="tooltip" title="{{ button_save_settings_title }}" class="btn btn-gcrdev-save">{{ button_save_settings|raw }}</button>
                  </div>
                </div>
              </div>
            </div>
          </form>
        </section>

        <!-- Help Tab -->
        <section id="content4">
          <div class="container-fluid">
            <input id="tab5" type="radio" name="help-tabs" checked>
            <label for="tab5">Sitemap</label>
            <input id="tab6" type="radio" name="help-tabs">
            <label for="tab6">Robots</label>
            <input id="tab7" type="radio" name="help-tabs">
            <label for="tab7">Settings</label>
            <section id="content5">
              <div class="panel panel-default">
                <div class="panel-heading">
                  <h3 class="panel-title"><i class="fa fa-question"></i> Sitemap {{ text_help_header }}</h3>
                </div>
                <div class="panel-body">
                  {{ text_sitemap_help|raw }}
                </div>
              </div>
            </section>
            <section id="content6">
              <div class="panel panel-default">
                <div class="panel-heading">
                  <h3 class="panel-title"><i class="fa fa-question"></i> Robots {{ text_help_header }}</h3>
                </div>
                <div class="panel-body">
                  {{ text_robots_help|raw }}
                </div>
              </div>
            </section>
            <section id="content7">
              <div class="panel panel-default">
                <div class="panel-heading">
                  <h3 class="panel-title"><i class="fa fa-question"></i> Settings {{ text_help_header }}</h3>
                </div>
                <div class="panel-body">
                  {{ text_settings_help|raw }}
                </div>
              </div>
            </section>
          </div>
        </section>
      </div>
    </main>
  </div>
</div>
{{ footer }}

<style>
.gcrdev-sitemap *, .gcrdev-sitemap *:before, .gcrdev-sitemap *:after { margin: 0; padding: 0; box-sizing: border-box; }
.gcrdev-sitemap p { margin: 0 0 20px; line-height: 1.5; }
.gcrdev-sitemap .text-centre { text-align: center; }
.gcrdev-sitemap { min-width: 320px; max-width: 100%; padding: 50px; padding-top: 0; margin: 0 auto; }
.gcrdev-sitemap section { display: none; padding: 20px 0 0; border-top: 1px solid #ddd; }
.gcrdev-sitemap .tab-content input[type="radio"] { display: none; }
.gcrdev-sitemap .tab-content label { display: inline-block; margin: 0 0 -1px; padding: 15px 25px; font-weight: 600; text-align: center; color: #bbb; border: 1px solid transparent; }
.gcrdev-sitemap .tab-content label:before { font-family: fontawesome; font-weight: normal; margin-right: 10px; }
.gcrdev-sitemap .tab-content label[for*='1']:before { content: '\f0e8'; }
.gcrdev-sitemap .tab-content label[for*='2']:before { content: '\f188'; }
.gcrdev-sitemap .tab-content label[for*='3']:before { content: '\f085'; }
.gcrdev-sitemap .tab-content label[for*='4']:before { content: '\f128'; }
.gcrdev-sitemap .tab-content label[for*='5']:before { content: '\f0e8'; }
.gcrdev-sitemap .tab-content label[for*='6']:before { content: '\f188'; }
.gcrdev-sitemap .tab-content label[for*='7']:before { content: '\f085'; }
.gcrdev-sitemap .tab-content label:hover { color: #888; cursor: pointer; }
.gcrdev-sitemap .tab-content input[type="radio"]:checked + label { cursor: text; }
.gcrdev-sitemap input:checked + label { color: #555; border: 1px solid #ddd; border-top: 2px solid #737373; border-bottom: 1px solid #fff; }
.gcrdev-sitemap #tab1:checked ~ #content1,
.gcrdev-sitemap #tab2:checked ~ #content2,
.gcrdev-sitemap #tab3:checked ~ #content3,
.gcrdev-sitemap #tab4:checked ~ #content4,
.gcrdev-sitemap #tab5:checked ~ #content5,
.gcrdev-sitemap #tab6:checked ~ #content6,
.gcrdev-sitemap #tab7:checked ~ #content7 { display: block; }
.gcrdev-sitemap ::-webkit-scrollbar { width: 10px; height: 10px; }
.gcrdev-sitemap ::-webkit-scrollbar-track { background-color: #DBDBDB; }
.gcrdev-sitemap ::-webkit-scrollbar-thumb { background-color: #737373; }
.gcrdev-sitemap ::-webkit-scrollbar-corner { background-color: #DBDBDB; }
.gcrdev-sitemap .invisi-btn-gcrdev { font-weight: bold; font-size: 20px; background-color: transparent; border: 0; outline: 0; cursor: pointer; }
.gcrdev-sitemap .btn-gcrdev-save { font-weight: bold; font-size: 20px; background-color: transparent; border: 0; outline: 0; cursor: pointer; padding: 15px; }
.gcrdev-sitemap .btn-gcrdev { font-weight: bold; font-size: 18px; background-color: transparent; border: 0; outline: 0; cursor: pointer; padding: 10px; margin-top: 1%; box-shadow: 0px 0px 0px, 0 2px 3px 0; }
.gcrdev-sitemap .btn-gcrdev:active { color: #737373; box-shadow: 0px 0px 0px, 0 1px 5px 0; }
.gcrdev-sitemap .table-input { width: 100%; padding: 5px; }
.gcrdev-sitemap input[type=number]::-webkit-inner-spin-button,
.gcrdev-sitemap input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; -moz-appearance: none; appearance: none; margin: 0; }
.gcrdev-sitemap select::-ms-expand { display: none; }
.gcrdev-sitemap select { -webkit-appearance: none; -moz-appearance: none; text-indent: 1px; text-overflow: ''; cursor: pointer; }
.gcrdev-sitemap .switch input[type="checkbox"] { position: absolute; opacity: 0; }
.gcrdev-sitemap .switch input[type="checkbox"].ios-switch + div { vertical-align: middle; width: 100%; height: 20px; border: 1px solid rgba(0,0,0,.4); border-radius: 999px; background-color: #FFFFFF; -webkit-transition-duration: .4s; -webkit-transition-property: background-color, box-shadow; box-shadow: inset 0 0 0 0px rgba(0,0,0,0.4); content: "x"; }
.gcrdev-sitemap .switch input[type="checkbox"].green.ios-switch:checked + div { background-color: #02C24D; border: 1px solid #02C24D; box-shadow: inset 0 0 0 10px #02C24D; -webkit-transition-timing-function: cubic-bezier(.54,1.85,.5,1); }
.gcrdev-sitemap .switch input[type="checkbox"].ios-switch + div > div { float: left; width: 100%; height: 100%; border-radius: inherit; background: #F10202; -webkit-transition-timing-function: cubic-bezier(.54,1.85,.5,1); -webkit-transition-duration: 0.4s; -webkit-transition-property: transform, background-color, box-shadow; -moz-transition-timing-function: cubic-bezier(.54,1.85,.5,1); -moz-transition-duration: 0.4s; -moz-transition-property: transform, background-color; box-shadow: 0px 0px 5px #F10202, 0px 0px 0 1px #F10202; pointer-events: none; }
.gcrdev-sitemap .switch input[type="checkbox"].green.ios-switch:checked + div > div { display: none; }
.gcrdev-sitemap .panel-default { overflow: auto; }
@media screen and (max-width: 650px) { .gcrdev-sitemap label { font-size: 0; } .gcrdev-sitemap .tab-content label:before { margin: 0; font-size: 18px; } }
@media screen and (max-width: 400px) { .gcrdev-sitemap label { padding: 15px; } }
</style>
