{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-option" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ action }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }} </h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }} </a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ heading_title }} </h3>
      </div>
      <div class="panel-body">
        <form action="{{ insert }}" method="post" enctype="multipart/form-data" id="form-option" class="form-horizontal">
          <div class="row">
            <div class="col-sm-6">
              <div class="form-group required">
                <label class="col-sm-4 control-label">{{ wk_opCustomer }} </label>
                <div class="col-sm-8">
                  <select name="opCustomerId" class="form-control">
                    <option value=""> - Select - </option>
                    {% if opCustomer %}
                      {% for value in opCustomer %}
                        <option value="{{ value.id }}" {% if value.id is same as (opCustomerId) %}{{ 'selected' }}{% endif %}> {{ value.name }}  </option>
                      {% endfor %}
                    {% endif %}
                  </select>
                </div>

              </div>
              <div class="form-group required">
                <label class="col-sm-4 control-label">{{ wk_opCustomerAddress }} </label>
                <div class="col-sm-8">
                  <select name="opCustomerAddressId" class="form-control">
                  </select>
                </div>
                {% if error_choose_ocaddress %}
                  <div class="text-danger"> {{ error_choose_ocaddress }}</div>
                {% endif %}
              </div>
            </div><!--col-Div-->

            <div class="col-sm-6">
              <div class="form-group required">
                <label class="col-sm-4 control-label">{{ wk_erpCustomerAddress }} </label>
                <div class="col-sm-8">
                  <select name="erpCustomerAddressId" class="form-control">
                  </select>
                </div>
                {% if error_choose_erpaddress %}
                  <div class="text-danger"> {{ error_choose_erpaddress }}</div>
                {% endif %}
              </div>
            </div><!--colDiv-->
          </div><!--end of row-->

        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript">
$(document).ready(function(){
  $.each($('select[name=\'opCustomerId\'] > option'),function(k,v){
        if($(this).attr('selected'))
          $(this).removeAttr('selected');
        });
});
$('select[name=\'opCustomerId\']').on("change", function(){
  thisId = $(this).val();

  $.ajax({
    url: 'index.php?route=catalog/wk_odoo_address/getaddress&user_token={{ user_token }}',
    type: 'post',
    data: 'customer_id=' + thisId,
    datatype: 'json',
    success: function(json){
      $('.alert').remove();
      if(json){
        var obj = JSON.parse(json);
        $('select[name=\'opCustomerAddressId\'] > option').remove();
        $('select[name=\'erpCustomerAddressId\'] > option').remove();

        if(obj.opAddress){
            for (var i = 0; i < obj['opAddress'].length; i++) {
              ophtml = '<option value='+obj['opAddress'][i]['opaddressId']+'>'+obj['opAddress'][i]['opaddressFirst']+'</option>';
              $('select[name=\'opCustomerAddressId\']').append(ophtml);
                if(obj['erpAddress']){
                  erphtml = '<option value='+obj['erpAddress'][i]['erpAddressId']+'>'+obj['erpAddress'][i]['erpAddressName']+'</option>';
                  $('select[name=\'erpCustomerAddressId\']').append(erphtml);
                }
            };
        }
      }
    }
  });// ajax end
}) // function end

</script>
{{ footer }}
