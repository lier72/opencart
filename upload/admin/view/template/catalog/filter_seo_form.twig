{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-filter-seo" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ facet.type_label }} &mdash; {{ facet.name }}{% if facet.group_name %} <small>({{ facet.group_name }})</small>{% endif %}</h3>
      </div>
      <div class="panel-body">
        {% if facet.colliding %}
        <div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_colliding_warning }}</div>
        {% endif %}
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-filter-seo" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-prefix-override">{{ entry_prefix_override }}</label>
            <div class="col-sm-10">
              <input type="text" name="prefix_override" value="{{ config.prefix_override }}" placeholder="{{ entry_prefix_override_placeholder }}" id="input-prefix-override" class="form-control" />
              <div class="help-block">{{ help_prefix_override }}</div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label"></label>
            <div class="col-sm-10">
              <div class="checkbox">
                <label><input type="checkbox" name="omit_facet_name" value="1"{% if config.omit_facet_name %} checked="checked"{% endif %} /> {{ entry_omit_facet_name }}</label>
              </div>
              <div class="help-block">{{ help_omit_facet_name }}</div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_strip }}</label>
            <div class="col-sm-10">
              <div class="checkbox">
                <label><input type="checkbox" name="strip_parenthetical" value="1"{% if config.strip_parenthetical %} checked="checked"{% endif %} /> {{ entry_strip_parenthetical }}</label>
              </div>
              <div class="checkbox">
                <label><input type="checkbox" name="strip_brackets" value="1"{% if config.strip_brackets %} checked="checked"{% endif %} /> {{ entry_strip_brackets }}</label>
              </div>
            </div>
          </div>
          <hr />
          <h4>{{ text_values }}</h4>
          <p class="text-muted">{{ text_values_help }}</p>
          <div class="table-responsive">
            <table class="table table-bordered">
              <thead>
                <tr>
                  <td class="text-left">{{ column_value }}</td>
                  <td class="text-left">{{ column_current_slug }}</td>
                  <td class="text-left">{{ column_value_override }}</td>
                </tr>
              </thead>
              <tbody>
                {% if values %}
                {% for value in values %}
                <tr>
                  <td class="text-left">{{ value.label }}</td>
                  <td class="text-left"><code>{{ value.slug ? value.slug : text_not_generated }}</code></td>
                  <td class="text-left"><input type="text" name="value_override[{{ value.field_key }}]" value="{{ value.override }}" class="form-control" /></td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="3">{{ text_no_results }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
        <form action="{{ regenerate }}" method="post" id="form-filter-seo-regenerate">
          <button type="submit" class="btn btn-default" onclick="return confirm('{{ text_confirm_regenerate }}');"><i class="fa fa-refresh"></i> {{ button_regenerate }}</button>
          <span class="help-block">{{ help_regenerate }}</span>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
