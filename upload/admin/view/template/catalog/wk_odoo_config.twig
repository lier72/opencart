{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form" class="form-horizontal">

          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-url">{{ url }}</label>
            <div class="col-sm-10">
              <input type="text" name="wkurl" value="{% if wkurl %}{{ wkurl }}{% endif %}" placeholder="{{ url }}" id="input-url" class="form-control" />
              <input type="hidden" name="wkid"  value="{% if wkid %}{{ wkid  }}{% endif %}">
            </div>
          </div>

          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-port">{{ port }}</label>
            <div class="col-sm-10">
              <input type="text" name="wkport" value="{% if wkport %}{{ wkport }}{% endif %}" placeholder="{{ port }}" id="input-port" class="form-control" />
            </div>
          </div>

          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-db_name">{{ db_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="wkdb_name" value="{% if wkdb_name %}{{ wkdb_name }}{% endif %}" placeholder="{{ db_name }}" id="input-db_name" class="form-control" />
            </div>
          </div>

          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-user">{{ user }}</label>
            <div class="col-sm-10">
              <input type="text" name="wkuser" value="{% if wkuser %}{{ wkuser }}{% endif %}" placeholder="{{ user }}" id="input-user" class="form-control" />
            </div>
          </div>

          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-password">{{ password }}</label>
            <div class="col-sm-10">
              <input type="text" name="wkpassword" value="{% if wkpassword %}{{ wkpassword }}{% endif %}" placeholder="{{ password }}" id="input-password" class="form-control" />
            </div>
          </div>


          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-product_sync_selection">{{ product_sync_selection }}</label>
            <div class="col-sm-10">
              <select name="wkproducttype" id="input-product_sync_selection" class="form-control">
                {% if wkproducttype=='variants' %}
                  <option value="template">Template</option>
                  <option value="variants" selected="selected">Variants (Using single optins only)</option>
                {% else %}
                  <option value="template" selected="selected">Template</option>
                  <option value="variants">Variants (Using single optins only)</option>
                {% endif %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-connection_status">{{ connection_status }}</label>
            <div class="col-sm-10">
              <input type="text" name="wkstatus" value="{% if wkstatus %}{{ wkstatus }}{% endif %}" placeholder="{{ connection_status }}" id="input-connection_status" class="form-control" readonly/>
            </div>
          </div>

          <div class="form-group">
            <div class="col-sm-12 text-right">
              <button type="button" class="btn btn-info" id="testcon">Test Connection!</button>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<script>
user_token = '{{ user_token }}';

function randString(n){

    keysize = jQuery('#key_size').val();

    if(n>=keysize){
        n = 16;
    }else{
        n = keysize;
    }
    var text = '';
    var possible = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()_+=-';

    for(var i=0; i < n; i++){
        text += possible.charAt(Math.floor(Math.random() * possible.length));
    }

    jQuery('#key_generate').val(text);
}

$('#testcon').bind('click', function() {
    jQuery('#form').attr('action','{{ chkconnection }}').submit();
    return;

    if($('input[name=\'wkurl\']').val()){
        $.ajax({
            url: 'index.php?route=catalog/wk_odoo_config/chkConnection&user_token='+user_token,
            type: 'POST',
            dataType: 'json',
            data: 'url=' + encodeURIComponent($('input[name=\'wkurl\']').val()) + '&port=' + encodeURIComponent($('input[name=\'wkport\']').val()) + '&db=' + encodeURIComponent($('input[name=\'wkdb_name\']').val()) + '&user=' + encodeURIComponent($('input[name=\'wkuser\']').val()) + '&pass=' + encodeURIComponent($('input[name=\'wkpassword\']').val()) ,
            beforeSend: function() {
                $('.success, .warning').remove();
                $('#testcon').attr('disabled', true);
                $('.box').before('<div class="attention"><img src="catalog/view/theme/default/image/loading.gif" alt="" style="width:20px;height:20px;"/> {{ text_wait }}</div>');
            },
            complete: function() {
                $('#testcon').attr('disabled', false);
                $('.attention').remove();
            },
            success: function(data) {
                if (data['error']) {
                    $('.box').before('<div class="warning">' + data['error'] + '</div>');
                }

                if (data['success']) {
                    $('.box').before('<div class="success">' + data['success'] + '</div>');
                    $('#successmsg').val(data['success']);
                }else{
                    $('#successmsg').val('');
                }
            }
        });
    }else{
        $('input[name=\'wkurl\']').css('border','1px solid red');
    }
});
</script>
{{ footer }}
