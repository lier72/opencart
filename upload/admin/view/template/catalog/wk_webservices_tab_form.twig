{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
         <a onclick="$('#form-save').submit();" data-toggle="tooltip" class="btn btn-primary" title="{{ button_save }}"><i class="fa fa-save"></i></a>
        <a onclick="location = '{{ cancel }}';" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default" ><i class="fa fa-reply"></i></a>
     </div>

      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

     <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-save" class="form-horizontal">

          <div class="form-group required">
                <label class="col-sm-3 control-label" for="input-">{{ wk_user }}</label>
                <div class="col-sm-9">
                  <input type="text" name="wk_user_val" class="form-control" value="{% if wk_user_val %}{{ wk_user_val  }}{% endif %}" required/>
                  <input type="hidden" name="wk_key_id" class="form-control" value="{% if wk_key_id %}{{ wk_key_id  }}{% endif %}" >
                </div>
              </div>

              <div class="form-group required">
                <label class="col-sm-3 control-label" for="input-">{{ wk_fname }}</label>
                <div class="col-sm-9">
                  <input type="text" name="wk_fname_val" class="form-control" value="{% if wk_fname_val %}{{ wk_fname_val }}{% endif %}" required/>
                </div>
              </div>

               <div class="form-group required">
                <label class="col-sm-3 control-label" for="input-">{{ wk_lname }}</label>
                <div class="col-sm-9">
                  <input type="text" name="wk_lname_val" class="form-control" value="{% if wk_lname_val %}{{ wk_lname_val }}{% endif %}" required/>
                </div>
              </div>

              <div class="form-group required">
                <label class="col-sm-3 control-label" for="input-">{{ wk_email }}</label>
                <div class="col-sm-9">
                   <input type="text" name="wk_email_val" class="form-control" value="{% if wk_email_val %}{{ wk_email_val }}{% endif %}" required/>
                </div>
              </div>

              <div class="form-group required">
                <label class="col-sm-3 control-label" for="input-">{{ wk_key }}</label>
                <div class="col-sm-9">
                  <input type="text" name="wk_key_val" class="form-control" id="key_generate" value="{% if wk_key_val %}{{ wk_key_val }}{% endif %}" {% if not required %}{{ 'required' }}{% endif %}/>
                </div>
              </div>

              <div class="form-group required">
                <label class="col-sm-3 control-label" for="input-">{{ wk_cnfrmkey }}</label>
                <div class="col-sm-9">
                   <input type="text" name="wk_cnfrmKey_val" class="form-control" value="{% if wk_cnfrmKey_val %}{{ wk_cnfrmKey_val }}{% endif %}"  {% if not required %}{{ 'required' }}{% endif %}>
                </div>
              </div>

              <div class="form-group required">
                <label class="col-sm-3 control-label" for="input-">{{ wk_key_description }}</label>
                <div class="col-sm-9">
                  <textarea name="wk_key_description_val" class="form-control" required >{% if wk_key_description_val %}{{ wk_key_description_val }}{% endif %}</textarea>
                </div>
              </div>

               <div class="form-group required">
                <label class="col-sm-3 control-label" for="input-">{{ wk_status }}</label>
                <div class="col-sm-9">
                   <select name="wk_status_val" class="form-control">
                  <option value='disable' {% if wk_status_val and wk_status_val is same as ('disable') %}{{ 'selected' }}{% endif %}>Disable</option>
                  <option value='enable' {% if wk_status_val and wk_status_val is same as ('enable') %}{{ 'selected' }}{% endif %}>Enable</option>
                </select>
                </div>
              </div>
        </form>
      </div><!--panel-body-->
      </div><!--panel panel-default-->
  </div><!--container-fluid-->
</div><!--content-->

<script>
function randString(n){
    keysize = jQuery('#key_size').val();
    if(n >= keysize){
        n = 16;
    }else{
        n = keysize;
    }
    var text = '';
    var possible = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()_+=-';
    for(var i=0; i < n; i++){
        text += possible.charAt(Math.floor(Math.random() * possible.length));
    }
    jQuery('#key_generate').val(text);
}
</script>
{{ footer }}
