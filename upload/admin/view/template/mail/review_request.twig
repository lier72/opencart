<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{ heading }}</title>
</head>
<body style="margin:0; padding:24px; background:#f4f6fb; font-family:Arial,Helvetica,sans-serif; color:#1f2937;">
  <table width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td align="center">
        <table width="640" cellpadding="0" cellspacing="0" border="0" style="max-width:640px; width:100%; background:#ffffff; border-radius:12px; overflow:hidden;">
          <tr>
            <td style="padding:32px;">
              <h2 style="margin:0 0 12px; font-size:28px; line-height:1.2;">{{ heading }}</h2>
              <p style="margin:0 0 8px; font-size:16px; line-height:1.6;">{{ intro }}</p>
              <p style="margin:0 0 24px; font-size:14px; color:#6b7280;">{{ order_hint }}</p>

              {% if channels %}
              <table cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
                <tr>
                  {% for channel in channels %}
                  <td style="padding:0 12px 12px 0;">
                    <a href="{{ channel.url }}" style="display:inline-block; padding:14px 20px; background:{{ channel.color }}; color:#ffffff; text-decoration:none; border-radius:8px; font-weight:bold;">{{ channel.label }}</a>
                  </td>
                  {% endfor %}
                </tr>
              </table>
              {% endif %}

              {% if product_review_links %}
              <div style="padding-top:20px; border-top:1px solid #e5e7eb;">
                <p style="margin:0 0 12px; font-size:16px; font-weight:bold;">{{ text_product_reviews }}</p>
                <ul style="margin:0; padding-left:18px;">
                  {% for product in product_review_links %}
                  <li style="margin-bottom:10px;"><a href="{{ product.url }}" style="color:#0f6bcf; text-decoration:none;">{{ product.name }}</a></li>
                  {% endfor %}
                </ul>
              </div>
              {% endif %}

              {% if order_link %}
              <p style="margin:24px 0 0;">
                <a href="{{ order_link }}" style="display:inline-block; padding:12px 18px; border:1px solid #cbd5e1; color:#0f172a; text-decoration:none; border-radius:8px;">{{ text_view_order }}</a>
              </p>
              {% endif %}

              <p style="margin:24px 0 0; font-size:15px;">{{ text_thanks }}</p>
              <p style="margin:8px 0 0; font-size:15px;">{{ signature }}</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
