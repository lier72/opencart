# Which LLM backend the chat orchestrator uses: "anthropic" or "openai".
LLM_PROVIDER=anthropic

# Only the key matching LLM_PROVIDER needs to be set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model id passed to the provider. Leave unset to use the provider's built-in default.
LLM_MODEL=

# Base URL of the OpenCart storefront this service reads racket data from.
# The two public endpoints it reads are:
#   {STOREFRONT_BASE_URL}/catalog/view/javascript/racket_finder/finder-data.json
#   {STOREFRONT_BASE_URL}/index.php?route=extension/module/racket_finder/data
STOREFRONT_BASE_URL=http://localhost/~max/oc3.uniqsport.ru

# How long the in-memory racket data cache is trusted before re-fetching, in seconds.
RACKET_DATA_TTL_SECONDS=600

# Port the HTTP /chat endpoint listens on. The OpenCart ai_chatbot module's
# "Chat service URL" setting must point here (e.g. http://localhost:8787).
PORT=8787

# Shared secret used to verify HMAC-SHA256 request signatures from the OpenCart
# ai_chatbot module proxy. Must match the module's "Shared secret" admin setting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_SHARED_SECRET=

# Maximum age, in seconds, of an incoming request's signed timestamp before it
# is rejected as a possible replay.
HMAC_REPLAY_WINDOW_SECONDS=300

# Safety caps on a single chat turn.
MAX_TOOL_ITERATIONS=6
MAX_RESPONSE_TOKENS=1024

# How long an idle conversation's in-memory history is kept, in seconds.
CONVERSATION_TTL_SECONDS=1800

# Caps the number of turns kept per conversation (oldest trimmed first), bounding
# both memory and per-request LLM cost for long-running chats.
CONVERSATION_MAX_MESSAGES=40

# Simple per-conversation/IP token-bucket rate limit.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
